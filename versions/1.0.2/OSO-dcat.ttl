@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/earthsemantics/OSO/1.0.2/complete> a dcat:Dataset ;
    dcterms:conformsTo <https://w3id.org/earthsemantics/OSO> ;
    dcterms:creator <https://orcid.org/0000-0001-8502-9812> ;
    dcterms:description "Combined distribution of OSO containing both the ontology model and the instance data."@en ;
    dcterms:hasPart <https://w3id.org/earthsemantics/OSO>,
        <https://w3id.org/earthsemantics/OSO/dataset> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-04-12"^^xsd:date ;
    dcterms:publisher <https://ror.org/044jxhp58> ;
    dcterms:title "OSO complete distribution"@en ;
    dcat:distribution <https://w3id.org/earthsemantics/OSO/1.0.2.jsonld>,
        <https://w3id.org/earthsemantics/OSO/1.0.2.n3>,
        <https://w3id.org/earthsemantics/OSO/1.0.2.nt>,
        <https://w3id.org/earthsemantics/OSO/1.0.2.owl>,
        <https://w3id.org/earthsemantics/OSO/1.0.2.trig>,
        <https://w3id.org/earthsemantics/OSO/1.0.2.ttl> ;
    dcat:version "1.0.2" .

<https://w3id.org/earthsemantics/OSO/dataset> a void:Dataset,
        dcat:Dataset ;
    dcterms:conformsTo <https://w3id.org/earthsemantics/OSO> ;
    dcterms:creator <https://orcid.org/0000-0001-8502-9812> ;
    dcterms:description "Instance data described using the Observatories of the Seas Ontology (OSO), including marine observatories, Regional Facilities, Sites, Platforms, organisations and related entities."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-04-12"^^xsd:date ;
    dcterms:publisher <https://ror.org/044jxhp58> ;
    dcterms:title "OSO Knowledge Graph"@en ;
    dcat:accessService <https://virtuoso.ifremer.fr/oso/sparql> ;
    dcat:distribution <https://w3id.org/earthsemantics/OSO/1.0.2/instances> ;
    dcat:version "1.0.2" .

<https://virtuoso.ifremer.fr/oso/sparql> a dcat:DataService ;
    dcterms:description "SPARQL endpoint providing query access to the OSO ontology and instance data."@en ;
    dcterms:title "OSO SPARQL endpoint"@en ;
    dcat:endpointURL <https://virtuoso.ifremer.fr/oso/sparql> ;
    dcat:landingPage <https://virtuoso.ifremer.fr/oso/> ;
    dcat:servesDataset <https://w3id.org/earthsemantics/OSO/1.0.2/complete> .

<https://w3id.org/earthsemantics/OSO/1.0.2.jsonld> a dcat:Distribution ;
    dcterms:format "application/ld+json" ;
    dcterms:title "OSO complete – JSON-LD distribution"@en ;
    dcat:downloadURL <https://w3id.org/earthsemantics/OSO/1.0.2.jsonld> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/ld+json> .

<https://w3id.org/earthsemantics/OSO/1.0.2.n3> a dcat:Distribution ;
    dcterms:format "text/n3" ;
    dcterms:title "OSO complete – N3 distribution"@en ;
    dcat:downloadURL <https://w3id.org/earthsemantics/OSO/1.0.2.n3> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/n3> .

<https://w3id.org/earthsemantics/OSO/1.0.2.nt> a dcat:Distribution ;
    dcterms:format "application/n-triples" ;
    dcterms:title "OSO complete – N-Triples distribution"@en ;
    dcat:downloadURL <https://w3id.org/earthsemantics/OSO/1.0.2.nt> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/n-triples> .

<https://w3id.org/earthsemantics/OSO/1.0.2.owl> a dcat:Distribution ;
    dcterms:format "application/rdf+xml" ;
    dcterms:title "OSO complete – RDF/XML distribution"@en ;
    dcat:downloadURL <https://w3id.org/earthsemantics/OSO/1.0.2.owl> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/rdf+xml> .

<https://w3id.org/earthsemantics/OSO/1.0.2.trig> a dcat:Distribution ;
    dcterms:format "application/trig" ;
    dcterms:title "OSO complete – TriG distribution"@en ;
    dcat:downloadURL <https://w3id.org/earthsemantics/OSO/1.0.2.trig> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/trig> .

<https://w3id.org/earthsemantics/OSO/1.0.2.ttl> a dcat:Distribution ;
    dcterms:format "text/turtle" ;
    dcterms:title "OSO complete – Turtle distribution"@en ;
    dcat:downloadURL <https://w3id.org/earthsemantics/OSO/1.0.2.ttl> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> .

<https://w3id.org/earthsemantics/OSO/1.0.2/instances> a dcat:Distribution ;
    dcterms:description "Instance-data distribution of the OSO Knowledge Graph, without the ontology schema."@en ;
    dcterms:format "text/turtle" ;
    dcterms:title "OSO instance data – Turtle distribution"@en ;
    dcat:downloadURL <https://w3id.org/earthsemantics/OSO/1.0.2/instances> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> .

<https://w3id.org/earthsemantics/OSO/1.0.2/ontology> a dcat:Distribution ;
    dcterms:description "Ontology-only distribution of OSO containing the ontology model, axioms and ontology metadata, without domain instance data."@en ;
    dcterms:format "text/turtle" ;
    dcterms:title "OSO ontology – Turtle distribution"@en ;
    dcat:downloadURL <https://w3id.org/earthsemantics/OSO/1.0.2/ontology> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> .

<https://w3id.org/earthsemantics/OSO/1.0.2/shacl> a dcat:Distribution ;
    dcterms:description "SHACL shapes used to validate OSO instance data against structural constraints."@en ;
    dcterms:format "text/turtle" ;
    dcterms:title "OSO SHACL validation shapes"@en ;
    dcat:downloadURL <https://w3id.org/earthsemantics/OSO/1.0.2/shacl> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> .

<https://w3id.org/earthsemantics/OSO> a owl:Ontology,
        dcat:Dataset ;
    dcterms:alternative "OSO"@en ;
    dcterms:created "2025-03-01"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-8502-9812> ;
    dcterms:description "OSO is an ontology designed to describe marine observatories, research infrastructures, observation platforms, associated organisations, scientific activities and related metadata in a FAIR and interoperable way."@en ;
    dcterms:hasVersion <https://w3id.org/earthsemantics/OSO/1.0.2> ;
    dcterms:identifier <https://doi.org/10.5281/zenodo.19497913> ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/el>,
        <http://id.loc.gov/vocabulary/iso639-1/en>,
        <http://id.loc.gov/vocabulary/iso639-1/es>,
        <http://id.loc.gov/vocabulary/iso639-1/fr>,
        <http://id.loc.gov/vocabulary/iso639-1/it>,
        <http://id.loc.gov/vocabulary/iso639-1/no>,
        <http://id.loc.gov/vocabulary/iso639-1/pt>,
        <http://id.loc.gov/vocabulary/iso639-1/ro> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-04-12"^^xsd:date ;
    dcterms:publisher <https://ror.org/044jxhp58> ;
    dcterms:title "Observatories of the Seas Ontology"@en ;
    pav:curatedBy <https://orcid.org/0000-0001-8502-9812> ;
    pav:previousVersion <https://w3id.org/earthsemantics/OSO/1.0.1> ;
    owl:versionInfo "1.0.2"@en ;
    dcat:distribution <https://w3id.org/earthsemantics/OSO/1.0.2/ontology>,
        <https://w3id.org/earthsemantics/OSO/1.0.2/shacl> ;
    dcat:keyword "FAIR"@en,
        "marine observatories"@en,
        "ocean observing systems"@en,
        "ontology"@en,
        "research infrastructures"@en,
        "semantic web"@en ;
    dcat:landingPage <https://earthportal.eu/ontologies/OSO> ;
    dcat:version "1.0.2" ;
    foaf:homepage <https://github.com/emso-eric/oso-ontology> .

