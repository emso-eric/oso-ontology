    rdfs:subPropertyOf dcterms:date .

csr:CruiseSummaryReport a owl:Class ;
    rdfs:subClassOf prov:Activity,
        OSO:SeriesOfOceanographicCampaigns ;
    owl:equivalentClass OSO:OceanographicCampaign ;
    skos:altLabel "Αποστολή"@el,
        "Cruise"@en,
        "Crucero"@es,
        "Campagne"@fr,
        "Crociera"@it,
        "Tokt"@no,
        "Cruzeiro"@pt,
        "Croazieră"@ro ;
    skos:prefLabel "Ωκεανογραφική εκστρατεία"@el,
        "Oceanographic campaign"@en,
        "Campaña oceanográfica"@es,
        "Campagne océanographique"@fr,
        "Campagna oceanografica"@it,
        "Havforskningstokt"@no,
        "Campanha oceanográfica"@pt,
        "Campanie oceanografică"@ro .

pav:authoredBy a owl:AnnotationProperty .

pav:createdBy a owl:AnnotationProperty .

pav:createdOn a owl:AnnotationProperty .

pav:createdWith a owl:AnnotationProperty .

pav:previousVersion a owl:AnnotationProperty .

pav:version a owl:AnnotationProperty .

vann:example a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

void:classes a owl:AnnotationProperty .

void:exampleResource a owl:AnnotationProperty .

void:inDataset a owl:AnnotationProperty .

void:properties a owl:AnnotationProperty .

void:triples a owl:AnnotationProperty .

void:uriSpace a owl:AnnotationProperty .

schema1:ImageObject a owl:Class ;
    rdfs:subClassOf schema1:CreativeWork,
        foaf:Document ;
    owl:equivalentClass foaf:Image .

schema1:codeRepository a owl:AnnotationProperty .

geosparql:asWKT a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:subPropertyOf foaf:title .

rdfs:Container a owl:Class ;
    rdfs:label "Container" ;
    metadata:prefixIRI "rdfs:Container" ;
    rdfs:comment "The class of RDF containers." ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:subClassOf rdfs:Resource .

rdfs:ContainerMembershipProperty a owl:Class ;
    rdfs:label "ContainerMembershipProperty" ;
    metadata:prefixIRI "rdfs:ContainerMembershipProperty" ;
    rdfs:comment "The class of container membership properties, rdf:_1, rdf:_2, ..., all of which are sub-properties of 'member'." ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:subClassOf rdf:Property .

rdfs:comment rdfs:label "comment" ;
    rdfs:comment "A description of the subject resource." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdfs:Literal .

rdfs:domain a owl:ObjectProperty ;
    rdfs:label "domain" ;
    rdfs:comment "A domain of the subject property." ;
    rdfs:domain rdf:Property ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdfs:Class .

rdfs:isDefinedBy rdfs:label "isDefinedBy" ;
    rdfs:comment "The definition of the subject resource." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdfs:Resource ;
    rdfs:subPropertyOf rdfs:seeAlso .

rdfs:member a owl:ObjectProperty ;
    rdfs:label "member" ;
    rdfs:comment "A member of the subject resource." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdfs:Resource .

rdfs:range a owl:ObjectProperty ;
    rdfs:label "range" ;
    rdfs:comment "A range of the subject property." ;
    rdfs:domain rdf:Property ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdfs:Class .

rdfs:subClassOf a owl:ObjectProperty ;
    rdfs:label "subClassOf" ;
    rdfs:comment "The subject is a subclass of a class." ;
    rdfs:domain rdfs:Class ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdfs:Class .

rdfs:subPropertyOf a owl:ObjectProperty ;
    rdfs:label "subPropertyOf" ;
    rdfs:comment "The subject is a subproperty of a property." ;
    rdfs:domain rdf:Property ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdf:Property .

<http://www.w3.org/2000/10/swap/pim/contact#Person> a owl:Class ;
    rdfs:subClassOf dcterms:Agent,
        owl:Thing,
        wgs84_pos:SpatialThing,
        foaf:Agent ;
    owl:equivalentClass foaf:Person .

xsd:gYearMonth a rdfs:Datatype .

owl:AllDisjointClasses a owl:Class ;
    rdfs:label "AllDisjointClasses" ;
    metadata:prefixIRI "owl:AllDisjointClasses" ;
    rdfs:comment "The class of collections of pairwise disjoint classes." ;
    rdfs:isDefinedBy owl: ;
    rdfs:subClassOf rdfs:Resource .

owl:AllDisjointProperties a owl:Class ;
    rdfs:label "AllDisjointProperties" ;
    metadata:prefixIRI "owl:AllDisjointProperties" ;
    rdfs:comment "The class of collections of pairwise disjoint properties." ;
    rdfs:isDefinedBy owl: ;
    rdfs:subClassOf rdfs:Resource .

owl:Annotation a owl:Class ;
    rdfs:label "Annotation" ;
    metadata:prefixIRI "owl:Annotation" ;
    rdfs:comment "The class of annotated annotations for which the RDF serialization consists of an annotated subject, predicate and object." ;
    rdfs:isDefinedBy owl: ;
    rdfs:subClassOf rdfs:Resource .

owl:AsymmetricProperty a owl:Class ;
    rdfs:label "AsymmetricProperty" ;
    metadata:prefixIRI "owl:AsymmetricProperty" ;
    rdfs:comment "The class of asymmetric properties." ;
    rdfs:isDefinedBy owl: ;
    rdfs:subClassOf owl:ObjectProperty .

owl:Axiom a owl:Class ;
    rdfs:label "Axiom" ;
    metadata:prefixIRI "owl:Axiom" ;
    rdfs:comment "The class of annotated axioms for which the RDF serialization consists of an annotated subject, predicate and object." ;
    rdfs:isDefinedBy owl: ;
    rdfs:subClassOf rdfs:Resource .

owl:DataRange a owl:Class ;
    rdfs:label "DataRange" ;
    metadata:prefixIRI "owl:DataRange" ;
    rdfs:comment "The class of OWL data ranges, which are special kinds of datatypes. Note: The use of the IRI owl:DataRange has been deprecated as of OWL 2. The IRI rdfs:Datatype SHOULD be used instead." ;
    rdfs:isDefinedBy owl: ;
    rdfs:subClassOf rdfs:Datatype .

owl:DeprecatedClass a owl:Class ;
    rdfs:label "DeprecatedClass" ;
    metadata:prefixIRI "owl:DeprecatedClass" ;
    rdfs:comment "The class of deprecated classes." ;
    rdfs:isDefinedBy owl: ;
    rdfs:subClassOf rdfs:Class .

owl:DeprecatedProperty a owl:Class ;
    rdfs:label "DeprecatedProperty" ;
    metadata:prefixIRI "owl:DeprecatedProperty" ;
    rdfs:comment "The class of deprecated properties." ;
    rdfs:isDefinedBy owl: ;
    rdfs:subClassOf rdf:Property .

owl:IrreflexiveProperty a owl:Class ;
    rdfs:label "IrreflexiveProperty" ;
    metadata:prefixIRI "owl:IrreflexiveProperty" ;
    rdfs:comment "The class of irreflexive properties." ;
    rdfs:isDefinedBy owl: ;
    rdfs:subClassOf owl:ObjectProperty .

owl:OntologyProperty a owl:Class ;
    rdfs:label "OntologyProperty" ;
    metadata:prefixIRI "owl:OntologyProperty" ;
    rdfs:comment "The class of ontology properties." ;
    rdfs:isDefinedBy owl: ;
    rdfs:subClassOf rdf:Property .

owl:ReflexiveProperty a owl:Class ;
    rdfs:label "ReflexiveProperty" ;
    metadata:prefixIRI "owl:ReflexiveProperty" ;
    rdfs:comment "The class of reflexive properties." ;
    rdfs:isDefinedBy owl: ;
    rdfs:subClassOf owl:ObjectProperty .

owl:allValuesFrom a owl:ObjectProperty ;
    rdfs:label "allValuesFrom" ;
    rdfs:comment "The property that determines the class that a universal property restriction refers to." ;
    rdfs:domain owl:Restriction ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdfs:Class .

owl:annotatedProperty a owl:ObjectProperty ;
    rdfs:label "annotatedProperty" ;
    rdfs:comment "The property that determines the predicate of an annotated axiom or annotated annotation." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdfs:Resource .

owl:annotatedSource a owl:ObjectProperty ;
    rdfs:label "annotatedSource" ;
    rdfs:comment "The property that determines the subject of an annotated axiom or annotated annotation." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdfs:Resource .

owl:annotatedTarget a owl:ObjectProperty ;
    rdfs:label "annotatedTarget" ;
    rdfs:comment "The property that determines the object of an annotated axiom or annotated annotation." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdfs:Resource .

owl:assertionProperty a owl:ObjectProperty ;
    rdfs:label "assertionProperty" ;
    rdfs:comment "The property that determines the predicate of a negative property assertion." ;
    rdfs:domain owl:NegativePropertyAssertion ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdf:Property .

owl:backwardCompatibleWith a owl:AnnotationProperty ;
    rdfs:label "backwardCompatibleWith" ;
    rdfs:comment "The annotation property that indicates that a given ontology is backward compatible with another ontology." ;
    rdfs:domain owl:Ontology ;
    rdfs:isDefinedBy owl: ;
    rdfs:range owl:Ontology .

owl:bottomDataProperty a owl:DatatypeProperty ;
    rdfs:label "bottomDataProperty" ;
    rdfs:comment "The data property that does not relate any individual to any data value." ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdfs:Literal .

owl:bottomObjectProperty a owl:ObjectProperty ;
    rdfs:label "bottomObjectProperty" ;
    rdfs:comment "The object property that does not relate any two individuals." ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy owl: ;
    rdfs:range owl:Thing .

owl:cardinality a owl:DatatypeProperty ;
    rdfs:label "cardinality" ;
    rdfs:comment "The property that determines the cardinality of an exact cardinality restriction." ;
    rdfs:domain owl:Restriction ;
    rdfs:isDefinedBy owl: ;
    rdfs:range xsd:nonNegativeInteger .

owl:complementOf a owl:ObjectProperty ;
    rdfs:label "complementOf" ;
    rdfs:comment "The property that determines that a given class is the complement of another class." ;
    rdfs:domain owl:Class ;
    rdfs:isDefinedBy owl: ;
    rdfs:range owl:Class .

owl:datatypeComplementOf a owl:ObjectProperty ;
    rdfs:label "datatypeComplementOf" ;
    rdfs:comment "The property that determines that a given data range is the complement of another data range with respect to the data domain." ;
    rdfs:domain rdfs:Datatype ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdfs:Datatype .

owl:deprecated a owl:AnnotationProperty ;
    rdfs:label "deprecated" ;
    rdfs:comment "The annotation property that indicates that a given entity has been deprecated." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdfs:Resource .

owl:differentFrom a owl:ObjectProperty ;
    rdfs:label "differentFrom" ;
    rdfs:comment "The property that determines that two given individuals are different." ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy owl: ;
    rdfs:range owl:Thing .

owl:disjointUnionOf a owl:ObjectProperty ;
    rdfs:label "disjointUnionOf" ;
    rdfs:comment "The property that determines that a given class is equivalent to the disjoint union of a collection of other classes." ;
    rdfs:domain owl:Class ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdf:List .

owl:disjointWith a owl:ObjectProperty ;
    rdfs:label "disjointWith" ;
    rdfs:comment "The property that determines that two given classes are disjoint." ;
    rdfs:domain owl:Class ;
    rdfs:isDefinedBy owl: ;
    rdfs:range owl:Class .

owl:distinctMembers a owl:ObjectProperty ;
    rdfs:label "distinctMembers" ;
    rdfs:comment "The property that determines the collection of pairwise different individuals in a owl:AllDifferent axiom." ;
    rdfs:domain owl:AllDifferent ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdf:List .

owl:equivalentClass a owl:ObjectProperty ;
    rdfs:label "equivalentClass" ;
    rdfs:comment "The property that determines that two given classes are equivalent, and that is used to specify datatype definitions." ;
    rdfs:domain rdfs:Class ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdfs:Class .

owl:equivalentProperty a owl:ObjectProperty ;
    rdfs:label "equivalentProperty" ;
    rdfs:comment "The property that determines that two given properties are equivalent." ;
    rdfs:domain rdf:Property ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdf:Property .

owl:hasKey a owl:ObjectProperty ;
    rdfs:label "hasKey" ;
    rdfs:comment "The property that determines the collection of properties that jointly build a key." ;
    rdfs:domain owl:Class ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdf:List .

owl:hasSelf a owl:ObjectProperty ;
    rdfs:label "hasSelf" ;
    rdfs:comment "The property that determines the property that a self restriction refers to." ;
    rdfs:domain owl:Restriction ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdfs:Resource .

owl:hasValue a owl:ObjectProperty ;
    rdfs:label "hasValue" ;
    rdfs:comment "The property that determines the individual that a has-value restriction refers to." ;
    rdfs:domain owl:Restriction ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdfs:Resource .

owl:imports a owl:AnnotationProperty ;
    rdfs:label "imports" ;
    rdfs:comment "The property that is used for importing other ontologies into a given ontology." ;
    rdfs:domain owl:Ontology ;
    rdfs:isDefinedBy owl: ;
    rdfs:range owl:Ontology .

owl:incompatibleWith a owl:AnnotationProperty ;
    rdfs:label "incompatibleWith" ;
    rdfs:comment "The annotation property that indicates that a given ontology is incompatible with another ontology." ;
    rdfs:domain owl:Ontology ;
    rdfs:isDefinedBy owl: ;
    rdfs:range owl:Ontology .

owl:intersectionOf a owl:ObjectProperty ;
    rdfs:label "intersectionOf" ;
    rdfs:comment "The property that determines the collection of classes or data ranges that build an intersection." ;
    rdfs:domain rdfs:Class ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdf:List .

owl:inverseOf a owl:ObjectProperty ;
    rdfs:label "inverseOf" ;
    rdfs:comment "The property that determines that two given properties are inverse." ;
    rdfs:domain owl:ObjectProperty ;
    rdfs:isDefinedBy owl: ;
    rdfs:range owl:ObjectProperty .

owl:maxCardinality a owl:DatatypeProperty ;
    rdfs:label "maxCardinality" ;
    rdfs:comment "The property that determines the cardinality of a maximum cardinality restriction." ;
    rdfs:domain owl:Restriction ;
    rdfs:isDefinedBy owl: ;
    rdfs:range xsd:nonNegativeInteger .

owl:maxQualifiedCardinality a owl:DatatypeProperty ;
    rdfs:label "maxQualifiedCardinality" ;
    rdfs:comment "The property that determines the cardinality of a maximum qualified cardinality restriction." ;
    rdfs:domain owl:Restriction ;
    rdfs:isDefinedBy owl: ;
    rdfs:range xsd:nonNegativeInteger .

owl:members a owl:ObjectProperty ;
    rdfs:label "members" ;
    rdfs:comment "The property that determines the collection of members in either a owl:AllDifferent, owl:AllDisjointClasses or owl:AllDisjointProperties axiom." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdf:List .

owl:minCardinality a owl:DatatypeProperty ;
    rdfs:label "minCardinality" ;
    rdfs:comment "The property that determines the cardinality of a minimum cardinality restriction." ;
    rdfs:domain owl:Restriction ;
    rdfs:isDefinedBy owl: ;
    rdfs:range xsd:nonNegativeInteger .

owl:minQualifiedCardinality a owl:DatatypeProperty ;
    rdfs:label "minQualifiedCardinality" ;
    rdfs:comment "The property that determines the cardinality of a minimum qualified cardinality restriction." ;
    rdfs:domain owl:Restriction ;
    rdfs:isDefinedBy owl: ;
    rdfs:range xsd:nonNegativeInteger .

owl:onClass a owl:ObjectProperty ;
    rdfs:label "onClass" ;
    rdfs:comment "The property that determines the class that a qualified object cardinality restriction refers to." ;
    rdfs:domain owl:Restriction ;
    rdfs:isDefinedBy owl: ;
    rdfs:range owl:Class .

owl:onDataRange a owl:ObjectProperty ;
    rdfs:label "onDataRange" ;
    rdfs:comment "The property that determines the data range that a qualified data cardinality restriction refers to." ;
    rdfs:domain owl:Restriction ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdfs:Datatype .

owl:onDatatype a owl:ObjectProperty ;
    rdfs:label "onDatatype" ;
    rdfs:comment "The property that determines the datatype that a datatype restriction refers to." ;
    rdfs:domain rdfs:Datatype ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdfs:Datatype .

owl:onProperties a owl:ObjectProperty ;
    rdfs:label "onProperties" ;
    rdfs:comment "The property that determines the n-tuple of properties that a property restriction on an n-ary data range refers to." ;
    rdfs:domain owl:Restriction ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdf:List .

owl:onProperty a owl:ObjectProperty ;
    rdfs:label "onProperty" ;
    rdfs:comment "The property that determines the property that a property restriction refers to." ;
    rdfs:domain owl:Restriction ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdf:Property .

owl:oneOf a owl:ObjectProperty ;
    rdfs:label "oneOf" ;
    rdfs:comment "The property that determines the collection of individuals or data values that build an enumeration." ;
    rdfs:domain rdfs:Class ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdf:List .

owl:priorVersion a owl:AnnotationProperty ;
    rdfs:label "priorVersion" ;
    rdfs:comment "The annotation property that indicates the predecessor ontology of a given ontology." ;
    rdfs:domain owl:Ontology ;
    rdfs:isDefinedBy owl: ;
    rdfs:range owl:Ontology .

owl:propertyChainAxiom a owl:ObjectProperty ;
    rdfs:label "propertyChainAxiom" ;
    rdfs:comment "The property that determines the n-tuple of properties that build a sub property chain of a given property." ;
    rdfs:domain owl:ObjectProperty ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdf:List .

owl:propertyDisjointWith a owl:ObjectProperty ;
    rdfs:label "propertyDisjointWith" ;
    rdfs:comment "The property that determines that two given properties are disjoint." ;
    rdfs:domain rdf:Property ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdf:Property .

owl:qualifiedCardinality a owl:DatatypeProperty ;
    rdfs:label "qualifiedCardinality" ;
    rdfs:comment "The property that determines the cardinality of an exact qualified cardinality restriction." ;
    rdfs:domain owl:Restriction ;
    rdfs:isDefinedBy owl: ;
    rdfs:range xsd:nonNegativeInteger .

owl:someValuesFrom a owl:ObjectProperty ;
    rdfs:label "someValuesFrom" ;
    rdfs:comment "The property that determines the class that an existential property restriction refers to." ;
    rdfs:domain owl:Restriction ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdfs:Class .

owl:sourceIndividual a owl:ObjectProperty ;
    rdfs:label "sourceIndividual" ;
    rdfs:comment "The property that determines the subject of a negative property assertion." ;
    rdfs:domain owl:NegativePropertyAssertion ;
    rdfs:isDefinedBy owl: ;
    rdfs:range owl:Thing .

owl:targetIndividual a owl:ObjectProperty ;
    rdfs:label "targetIndividual" ;
    rdfs:comment "The property that determines the object of a negative object property assertion." ;
    rdfs:domain owl:NegativePropertyAssertion ;
    rdfs:isDefinedBy owl: ;
    rdfs:range owl:Thing .

owl:targetValue a owl:ObjectProperty ;
    rdfs:label "targetValue" ;
    rdfs:comment "The property that determines the value of a negative data property assertion." ;
    rdfs:domain owl:NegativePropertyAssertion ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdfs:Literal .

owl:topDataProperty a owl:DatatypeProperty ;
    rdfs:label "topDataProperty" ;
    rdfs:comment "The data property that relates every individual to every data value." ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdfs:Literal .

owl:topObjectProperty a owl:ObjectProperty ;
    rdfs:label "topObjectProperty" ;
    rdfs:comment "The object property that relates every two individuals." ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy owl: ;
    rdfs:range owl:Thing .

owl:unionOf a owl:ObjectProperty ;
    rdfs:label "unionOf" ;
    rdfs:comment "The property that determines the collection of classes or data ranges that build a union." ;
    rdfs:domain rdfs:Class ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdf:List .

owl:versionIRI a owl:AnnotationProperty ;
    rdfs:label "versionIRI" ;
    rdfs:comment "The property that identifies the version IRI of an ontology." ;
    rdfs:domain owl:Ontology ;
    rdfs:isDefinedBy owl: ;
    rdfs:range owl:Ontology .

owl:versionInfo a owl:AnnotationProperty ;
    rdfs:label "versionInfo" ;
    rdfs:comment "The annotation property that provides version information for an ontology or another OWL construct." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdfs:Resource .

owl:withRestrictions a owl:ObjectProperty ;
    rdfs:label "withRestrictions" ;
    rdfs:comment "The property that determines the collection of facet-value pairs that define a datatype restriction." ;
    rdfs:domain rdfs:Datatype ;
    rdfs:isDefinedBy owl: ;
    rdfs:range rdf:List .

wgs84_pos:Point a owl:Class ;
    rdfs:label "point" ;
    rdfs:comment """ 
Uniquely identified by lat/long/alt. i.e.

spaciallyIntersects(P1, P2) :- lat(P1, LAT), long(P1, LONG), alt(P1, ALT),
  lat(P2, LAT), long(P2, LONG), alt(P2, ALT).

sameThing(P1, P2) :- type(P1, Point), type(P2, Point), spaciallyIntersects(P1, P2).
  """,
        """A point, typically described using a coordinate system relative to Earth, such as WGS84.
  """ ;
    rdfs:subClassOf wgs84_pos:SpatialThing .

wgs84_pos:alt a owl:AnnotationProperty ;
    rdfs:label "altitude" ;
    rdfs:comment """The WGS84 altitude of a SpatialThing (decimal meters 
above the local reference ellipsoid).""" ;
    rdfs:domain wgs84_pos:SpatialThing .

wgs84_pos:lat a owl:AnnotationProperty ;
    rdfs:label "latitude" ;
    rdfs:comment "The WGS84 latitude of a SpatialThing (decimal degrees)." ;
    rdfs:domain wgs84_pos:SpatialThing .

wgs84_pos:location a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:range wgs84_pos:SpatialThing ;
    rdfs:subPropertyOf foaf:based_near .

wgs84_pos:long a owl:AnnotationProperty ;
    rdfs:label "longitude" ;
    rdfs:comment "The WGS84 longitude of a SpatialThing (decimal degrees)." ;
    rdfs:domain wgs84_pos:SpatialThing .

wgs84_pos:wktLiteral a rdfs:Datatype .

ns:term_status a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty ;
    rdfs:label "alternative label"@el,
        "alternative label"@en,
        "alternative label"@es,
        "alternative label"@fr,
        "alternative label"@it,
        "alternative label"@no,
        "alternative label"@pt,
        "alternative label"@ro ;
    rdfs:comment "The range of skos:altLabel is the class of RDF plain literals."@el,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@el,
        "The range of skos:altLabel is the class of RDF plain literals."@en,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@en,
        "The range of skos:altLabel is the class of RDF plain literals."@es,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@es,
        "The range of skos:altLabel is the class of RDF plain literals."@fr,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@fr,
        "The range of skos:altLabel is the class of RDF plain literals."@it,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@it,
        "The range of skos:altLabel is the class of RDF plain literals."@no,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@no,
        "The range of skos:altLabel is the class of RDF plain literals."@pt,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@pt,
        "The range of skos:altLabel is the class of RDF plain literals."@ro,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf rdfs:label ;
    skos:definition "An alternative lexical label for a resource."@en ;
    skos:example "Acronyms, abbreviations, spelling variants, and irregular plural/singular forms may be included among the alternative labels for a concept. Mis-spelled terms are normally included as hidden labels (see skos:hiddenLabel)."@en .

skos:broadMatch a owl:ObjectProperty ;
    rdfs:label "has broader match"@el,
        "has broader match"@en,
        "has broader match"@es,
        "has broader match"@fr,
        "has broader match"@it,
        "has broader match"@no,
        "has broader match"@pt,
        "has broader match"@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:broader,
        skos:mappingRelation ;
    owl:inverseOf skos:narrowMatch ;
    skos:definition "skos:broadMatch is used to state a hierarchical mapping link between two conceptual resources in different concept schemes."@en .

skos:changeNote a owl:AnnotationProperty ;
    rdfs:label "change note"@el,
        "change note"@en,
        "change note"@es,
        "change note"@fr,
        "change note"@it,
        "change note"@no,
        "change note"@pt,
        "change note"@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "A note about a modification to a concept."@en .

skos:definition a owl:AnnotationProperty ;
    rdfs:label "definition"@el,
        "definition"@en,
        "definition"@es,
        "definition"@fr,
        "definition"@it,
        "definition"@no,
        "definition"@pt,
        "definition"@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "A statement or formal explanation of the meaning of a concept."@en .

skos:editorialNote a owl:AnnotationProperty ;
    rdfs:label "editorial note"@el,
        "editorial note"@en,
        "editorial note"@es,
        "editorial note"@fr,
        "editorial note"@it,
        "editorial note"@no,
        "editorial note"@pt,
        "editorial note"@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "A note for an editor, translator or maintainer of the vocabulary."@en .

skos:example a owl:AnnotationProperty ;
    rdfs:label "example"@el,
        "example"@en,
        "example"@es,
        "example"@fr,
        "example"@it,
        "example"@no,
        "example"@pt,
        "example"@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "An example of the use of a concept."@en .

skos:hasTopConcept a owl:ObjectProperty ;
    rdfs:label "has top concept"@el,
        "has top concept"@en,
        "has top concept"@es,
        "has top concept"@fr,
        "has top concept"@it,
        "has top concept"@no,
        "has top concept"@pt,
        "has top concept"@ro ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:Concept ;
    owl:inverseOf skos:topConceptOf ;
    skos:definition "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme, providing an entry point to these hierarchies."@en .

skos:hiddenLabel a owl:AnnotationProperty ;
    rdfs:label "hidden label"@el,
        "hidden label"@en,
        "hidden label"@es,
        "hidden label"@fr,
        "hidden label"@it,
        "hidden label"@no,
        "hidden label"@pt,
        "hidden label"@ro ;
    rdfs:comment "The range of skos:hiddenLabel is the class of RDF plain literals."@el,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@el,
        "The range of skos:hiddenLabel is the class of RDF plain literals."@en,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@en,
        "The range of skos:hiddenLabel is the class of RDF plain literals."@es,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@es,
        "The range of skos:hiddenLabel is the class of RDF plain literals."@fr,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@fr,
        "The range of skos:hiddenLabel is the class of RDF plain literals."@it,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@it,
        "The range of skos:hiddenLabel is the class of RDF plain literals."@no,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@no,
        "The range of skos:hiddenLabel is the class of RDF plain literals."@pt,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@pt,
        "The range of skos:hiddenLabel is the class of RDF plain literals."@ro,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf rdfs:label ;
    skos:definition "A lexical label for a resource that should be hidden when generating visual displays of the resource, but should still be accessible to free text search operations."@en .

skos:historyNote a owl:AnnotationProperty ;
    rdfs:label "history note"@el,
        "history note"@en,
        "history note"@es,
        "history note"@fr,
        "history note"@it,
        "history note"@no,
        "history note"@pt,
        "history note"@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "A note about the past state/use/meaning of a concept."@en .

skos:member a owl:ObjectProperty ;
    rdfs:label "has member"@en ;
    rdfs:domain skos:Collection ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( skos:Collection skos:Concept ) ] ;
    skos:definition "Relates a collection to one of its members."@en ;
    skos:prefLabel "έχει μέλος"@el,
        "has member"@en,
        "tiene miembro"@es,
        "a pour membre"@fr,
        "ha membro"@it,
        "har medlem"@no,
        "tem membro"@pt,
        "are membru"@ro .

skos:memberList a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has member list"@en ;
    rdfs:comment """For any resource, every item in the list given as the value of the
      skos:memberList property is also a value of the skos:member property."""@el,
        """For any resource, every item in the list given as the value of the
      skos:memberList property is also a value of the skos:member property."""@en,
        """For any resource, every item in the list given as the value of the
      skos:memberList property is also a value of the skos:member property."""@es,
        """For any resource, every item in the list given as the value of the
      skos:memberList property is also a value of the skos:member property."""@fr,
        """For any resource, every item in the list given as the value of the
      skos:memberList property is also a value of the skos:member property."""@it,
        """For any resource, every item in the list given as the value of the
      skos:memberList property is also a value of the skos:member property."""@no,
        """For any resource, every item in the list given as the value of the
      skos:memberList property is also a value of the skos:member property."""@pt,
        """For any resource, every item in the list given as the value of the
      skos:memberList property is also a value of the skos:member property."""@ro ;
    rdfs:domain skos:OrderedCollection ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range rdf:List ;
    skos:definition "Relates an ordered collection to the RDF list containing its members."@en ;
    skos:prefLabel "έχει λίστα μελών"@el,
        "has member list"@en,
        "tiene lista de miembros"@es,
        "a pour liste de membres"@fr,
        "ha elenco dei membri"@it,
        "har medlemsliste"@no,
        "tem lista de membros"@pt,
        "are listă de membri"@ro .

skos:notation a owl:DatatypeProperty ;
    rdfs:label "notation"@el,
        "notation"@en,
        "notation"@es,
        "notation"@fr,
        "notation"@it,
        "notation"@no,
        "notation"@pt,
        "notation"@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "A notation, also known as classification code, is a string of characters such as \"T58.5\" or \"303.4833\" used to uniquely identify a concept within the scope of a given concept scheme."@en ;
    skos:scopeNote "By convention, skos:notation is used with a typed literal in the object position of the triple."@en .

skos:prefLabel a owl:AnnotationProperty ;
    rdfs:label "preferred label"@el,
        "preferred label"@en,
        "preferred label"@es,
        "preferred label"@fr,
        "preferred label"@it,
        "preferred label"@no,
        "preferred label"@pt,
        "preferred label"@ro ;
    rdfs:comment "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag."@el,
        "The range of skos:prefLabel is the class of RDF plain literals."@el,
        """skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise
      disjoint properties."""@el,
        "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag."@en,
        "The range of skos:prefLabel is the class of RDF plain literals."@en,
        """skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise
      disjoint properties."""@en,
        "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag."@es,
        "The range of skos:prefLabel is the class of RDF plain literals."@es,
        """skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise
      disjoint properties."""@es,
        "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag."@fr,
        "The range of skos:prefLabel is the class of RDF plain literals."@fr,
        """skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise
      disjoint properties."""@fr,
        "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag."@it,
        "The range of skos:prefLabel is the class of RDF plain literals."@it,
        """skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise
      disjoint properties."""@it,
        "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag."@no,
        "The range of skos:prefLabel is the class of RDF plain literals."@no,
        """skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise
      disjoint properties."""@no,
        "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag."@pt,
        "The range of skos:prefLabel is the class of RDF plain literals."@pt,
        """skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise
      disjoint properties."""@pt,
        "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag."@ro,
        "The range of skos:prefLabel is the class of RDF plain literals."@ro,
        """skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise
      disjoint properties."""@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf rdfs:label ;
    skos:definition "The preferred lexical label for a resource, in a given language."@en .

skos:relatedMatch a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has related match"@el,
        "has related match"@en,
        "has related match"@es,
        "has related match"@fr,
        "has related match"@it,
        "has related match"@no,
        "has related match"@pt,
        "has related match"@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:mappingRelation,
        skos:related ;
    skos:definition "skos:relatedMatch is used to state an associative mapping link between two conceptual resources in different concept schemes."@en .

skos:scopeNote a owl:AnnotationProperty ;
    rdfs:label "scope note"@el,
        "scope note"@en,
        "scope note"@es,
        "scope note"@fr,
        "scope note"@it,
        "scope note"@no,
        "scope note"@pt,
        "scope note"@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
