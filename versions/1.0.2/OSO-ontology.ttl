omv:designedForOntologyTask a owl:AnnotationProperty ;
    rdfs:label "Designed for Ontology Task"@en ;
    rdfs:comment "Indicates the task or purpose for which the ontology has been specifically developed"@en ;
    skos:prefLabel "Designed for Ontology Task"@en .

