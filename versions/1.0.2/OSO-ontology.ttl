cerif:Organisation a owl:Class ;
    rdfs:label "Organisation"@en ;
    rdfs:comment "An entity that performs activities such as research, funding, or coordination, including universities, research centres, and companies."@en ;
    owl:equivalentClass OSO:ERIC,
        OSO:ResearchInfrastructure .

OSO:Discipline a owl:Class ;
    rdfs:label "Discipline"@el,
        "Discipline"@en,
        "Discipline"@es,
        "Discipline"@fr,
        "Discipline"@it,
        "Discipline"@no,
        "Discipline"@pt,
        "Discipline"@ro ;
    metadata:prefixIRI "Discipline",
        "omv:Discipline" ;
    rdfs:comment "List of EMSO scientific disciplines associated to a Regional Facility"@el,
        "List of EMSO scientific disciplines associated to a Regional Facility"@en,
        "List of EMSO scientific disciplines associated to a Regional Facility"@es,
        "List of EMSO scientific disciplines associated to a Regional Facility"@fr,
        "List of EMSO scientific disciplines associated to a Regional Facility"@it,
        "List of EMSO scientific disciplines associated to a Regional Facility"@no,
        "List of EMSO scientific disciplines associated to a Regional Facility"@pt,
        "List of EMSO scientific disciplines associated to a Regional Facility"@ro ;
    rdfs:subClassOf owl:Thing ;
    skos:prefLabel "Discipline"@el,
        "Discipline"@en,
        "Discipline"@es,
        "Discipline"@fr,
        "Discipline"@it,
        "Discipline"@no,
        "Discipline"@pt,
        "Discipline"@ro .

OSO:DistanceFromLand a owl:DatatypeProperty ;
    rdfs:label "Distance from land"@el,
        "Distance from land"@en,
        "Distance from land"@es,
        "Distance from land"@fr,
        "Distance from land"@it,
        "Distance from land"@no,
        "Distance from land"@pt,
        "Distance from land"@ro ;
    qudt:unit unit:NauticalMile ;
    rdfs:comment "value expressed in nautical miles (NM)"@el,
        "value expressed in nautical miles (NM)"@en,
        "value expressed in nautical miles (NM)"@es,
        "value expressed in nautical miles (NM)"@fr,
        "value expressed in nautical miles (NM)"@it,
        "value expressed in nautical miles (NM)"@no,
        "value expressed in nautical miles (NM)"@pt,
        "value expressed in nautical miles (NM)"@ro ;
    rdfs:domain OSO:RegionalFacility,
        OSO:Site ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Distance from land"@el,
        "Distance from land"@en,
        "Distance from land"@es,
        "Distance from land"@fr,
        "Distance from land"@it,
        "Distance from land"@no,
        "Distance from land"@pt,
        "Distance from land"@ro .

