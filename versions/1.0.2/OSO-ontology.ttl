        "Associe une infrastructure ou un système à un ou plusieurs sites d’observation."@fr ;
    rdfs:domain OSO:RegionalFacility ;
    rdfs:range OSO:Site .

OSO:isERICMembershipOf a owl:ObjectProperty ;
    rdfs:label "είναι συμμετοχή σε ERIC του"@el,
        "is ERIC membership of"@en,
        "es membresía en un ERIC de"@es,
        "est une appartenance à un ERIC de"@fr,
        "è appartenenza a un ERIC di"@it,
        "er medlemskap i et ERIC for"@no,
        "é participação em um ERIC de"@pt,
        "este apartenență la un ERIC a"@ro ;
    rdfs:domain OSO:ERICMembership ;
    rdfs:range OSO:RegionalFacility ;
    owl:inverseOf OSO:hasERICMembership ;
    skos:prefLabel "είναι συμμετοχή σε ERIC του"@el,
        "is ERIC membership of"@en,
        "es membresía en un ERIC de"@es,
        "est une appartenance à un ERIC de"@fr,
        "è appartenenza a un ERIC di"@it,
        "er medlemskap i et ERIC for"@no,
        "é participação em um ERIC de"@pt,
        "este apartenență la un ERIC a"@ro .

