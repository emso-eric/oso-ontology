    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subClassOf skos:Collection ;
    skos:definition "An ordered collection of concepts, where both the grouping and the ordering are meaningful."@en ;
    skos:scopeNote "Ordered collections can be used where you would like a set of concepts to be displayed in a specific order, and optionally under a 'node label'."@en .

skos:broader a owl:ObjectProperty ;
    rdfs:label "has broader"@el,
        "has broader"@en,
        "has broader"@es,
        "has broader"@fr,
        "has broader"@it,
        "has broader"@no,
        "has broader"@pt,
        "has broader"@ro ;
    rdfs:comment "Broader concepts are typically rendered as parents in a concept hierarchy (tree)."@el,
        "Broader concepts are typically rendered as parents in a concept hierarchy (tree)."@en,
        "Broader concepts are typically rendered as parents in a concept hierarchy (tree)."@es,
        "Broader concepts are typically rendered as parents in a concept hierarchy (tree)."@fr,
        "Broader concepts are typically rendered as parents in a concept hierarchy (tree)."@it,
        "Broader concepts are typically rendered as parents in a concept hierarchy (tree)."@no,
        "Broader concepts are typically rendered as parents in a concept hierarchy (tree)."@pt,
        "Broader concepts are typically rendered as parents in a concept hierarchy (tree)."@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:broaderTransitive ;
    owl:inverseOf skos:narrower ;
    skos:definition "Relates a concept to a concept that is more general in meaning."@en ;
    skos:scopeNote "By convention, skos:broader is only used to assert an immediate (i.e. direct) hierarchical link between two conceptual resources."@en .

skos:broaderTransitive a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has broader transitive"@el,
        "has broader transitive"@en,
        "has broader transitive"@es,
        "has broader transitive"@fr,
        "has broader transitive"@it,
        "has broader transitive"@no,
        "has broader transitive"@pt,
        "has broader transitive"@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:semanticRelation ;
    owl:inverseOf skos:narrowerTransitive ;
    skos:definition "skos:broaderTransitive is a transitive superproperty of skos:broader." ;
    skos:scopeNote "By convention, skos:broaderTransitive is not used to make assertions. Rather, the properties can be used to draw inferences about the transitive closure of the hierarchical relation, which is useful e.g. when implementing a simple query expansion algorithm in a search application."@en .

skos:closeMatch a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has close match"@el,
        "has close match"@en,
        "has close match"@es,
        "has close match"@fr,
        "has close match"@it,
        "has close match"@no,
        "has close match"@pt,
        "has close match"@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:mappingRelation ;
    skos:definition "skos:closeMatch is used to link two concepts that are sufficiently similar that they can be used interchangeably in some information retrieval applications. In order to avoid the possibility of \"compound errors\" when combining mappings across more than two concept schemes, skos:closeMatch is not declared to be a transitive property."@en .

skos:inScheme a owl:ObjectProperty ;
    rdfs:label "is in scheme"@el,
        "is in scheme"@en,
        "is in scheme"@es,
        "is in scheme"@fr,
        "is in scheme"@it,
        "is in scheme"@no,
        "is in scheme"@pt,
        "is in scheme"@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:ConceptScheme ;
    skos:definition "Relates a resource (for example a concept) to a concept scheme in which it is included."@en ;
    skos:scopeNote "A concept may be a member of more than one concept scheme."@en .

skos:narrowMatch a owl:ObjectProperty ;
    rdfs:label "has narrower match"@el,
        "has narrower match"@en,
        "has narrower match"@es,
        "has narrower match"@fr,
        "has narrower match"@it,
        "has narrower match"@no,
        "has narrower match"@pt,
        "has narrower match"@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:mappingRelation,
        skos:narrower ;
    skos:definition "skos:narrowMatch is used to state a hierarchical mapping link between two conceptual resources in different concept schemes."@en .

skos:related a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has related"@el,
        "has related"@en,
        "has related"@es,
        "has related"@fr,
        "has related"@it,
        "has related"@no,
        "has related"@pt,
        "has related"@ro ;
    rdfs:comment "skos:related is disjoint with skos:broaderTransitive"@el,
        "skos:related is disjoint with skos:broaderTransitive"@en,
        "skos:related is disjoint with skos:broaderTransitive"@es,
        "skos:related is disjoint with skos:broaderTransitive"@fr,
        "skos:related is disjoint with skos:broaderTransitive"@it,
        "skos:related is disjoint with skos:broaderTransitive"@no,
        "skos:related is disjoint with skos:broaderTransitive"@pt,
        "skos:related is disjoint with skos:broaderTransitive"@ro ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:semanticRelation ;
    skos:definition "Relates a concept to a concept with which there is an associative semantic relationship."@en .

skos:topConceptOf a owl:ObjectProperty ;
    rdfs:label "is top concept in scheme"@el,
        "is top concept in scheme"@en,
        "is top concept in scheme"@es,
        "is top concept in scheme"@fr,
        "is top concept in scheme"@it,
        "is top concept in scheme"@no,
        "is top concept in scheme"@pt,
        "is top concept in scheme"@ro ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:ConceptScheme ;
    rdfs:subPropertyOf skos:inScheme ;
    skos:definition "Relates a concept to the concept scheme that it is a top level concept of."@en .

foaf:Group a owl:Class ;
    rdfs:label "Group" ;
    metadata:prefixIRI "foaf:Group" ;
    rdfs:comment "A class of Agents." ;
    rdfs:subClassOf dcterms:Agent,
        foaf:Agent ;
    ns:term_status "stable" .

foaf:based_near a owl:ObjectProperty ;
    rdfs:label "based near" ;
    rdfs:comment "A location that something is based near, for some broadly human notion of near." ;
    rdfs:domain wgs84_pos:SpatialThing ;
    rdfs:isDefinedBy foaf: ;
    rdfs:range wgs84_pos:SpatialThing ;
    ns:term_status "testing" .

foaf:depiction a owl:ObjectProperty ;
    rdfs:label "depiction" ;
    rdfs:comment "A depiction of some thing." ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy foaf: ;
    rdfs:range foaf:Image ;
    owl:inverseOf foaf:depicts ;
    ns:term_status "testing" .

foaf:depicts a owl:ObjectProperty ;
    rdfs:label "depicts" ;
    rdfs:comment "A thing depicted in this representation." ;
    rdfs:domain foaf:Image ;
    rdfs:isDefinedBy foaf: ;
    rdfs:range owl:Thing ;
    ns:term_status "testing" .

foaf:maker a owl:ObjectProperty ;
    rdfs:label "maker" ;
    rdfs:comment "An agent that  made this thing." ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy foaf: ;
    rdfs:range foaf:Agent ;
    ns:term_status "stable" .

foaf:primaryTopic a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "primary topic" ;
    rdfs:comment "The primary topic of some page or document." ;
    rdfs:domain foaf:Document ;
    rdfs:isDefinedBy foaf: ;
    rdfs:range owl:Thing ;
    ns:term_status "stable" .

foaf:title a owl:AnnotationProperty,
        owl:DatatypeProperty .

foaf:topic a owl:ObjectProperty ;
    rdfs:label "topic" ;
    rdfs:comment "A topic of some page or document." ;
    rdfs:domain foaf:Document ;
    rdfs:isDefinedBy foaf: ;
    rdfs:range owl:Thing ;
    ns:term_status "testing" .

OSO:hasERICMembership a owl:ObjectProperty ;
    rdfs:label "έχει συμμετοχή σε ERIC"@el,
        "has ERIC membership"@en,
        "tiene membresía en un ERIC"@es,
        "a une appartenance à un ERIC"@fr,
        "ha un'appartenenza a un ERIC"@it,
        "har medlemskap i et ERIC"@no,
        "tem participação em um ERIC"@pt,
        "are apartenență la un ERIC"@ro ;
    rdfs:comment "Links a regional facility to its membership within an ERIC infrastructure."@en,
        "Relie une infrastructure régionale à son appartenance à un ERIC."@fr ;
