        owl:DatatypeProperty,
        owl:NamedIndividual ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date .

dcterms:creator a owl:AnnotationProperty,
        owl:NamedIndividual ;
