OSO:AtlanticWhaleDealbbox a owl:NamedIndividual,
        wgs84_pos:BoundingBox ;
    wgs84_pos:Latitude 3.6e+01,
        6.2e+01 ;
    wgs84_pos:Longitude -2e+01,
        5e+00 ;
    skos:prefLabel "Atlantic WhaleDeal Bouding box"@en .

OSO:Atlantic_Whale_Deal a owl:NamedIndividual,
        OSO:FundedProject ;
    rdfs:label "Atlantic Whale Deal"@el,
        "Atlantic Whale Deal"@en,
        "Atlantic Whale Deal"@es,
        "Atlantic Whale Deal"@fr,
        "Atlantic Whale Deal"@it,
        "Atlantic Whale Deal"@no,
        "Atlantic Whale Deal"@pt,
        "Atlantic Whale Deal"@ro ;
    dcterms:description """The ATLANTIC WHALE DEAL aims to make sure that ships don't accidentally hit whales in the Atlantic Area.

Partners from different countries are working together to prevent these collisions that can damage biodiversity, trying out new and smart technologies to reduce ship strikes. They want to help the environment by capturing carbon (which is good for the planet) and making sure the ecosystem works well. This involves localization techniques to find whales, making maps to show where there's a risk of collisions, and creating tools to reduce noise in the ocean.


A team of experts in physics, engineering, biology, statistics, design, and social economics from four countries is teaming up with different organizations like the government, non-profit groups, schools, and businesses. The goal is to find solutions that work well and help society while also taking care of the planet.

ATLANTIC WHALE DEAL believes that by protecting whales, they're also making a positive impact on the world by keeping the environment healthy and preserving biodiversity.""" ;
    dcterms:title "Atlantic Whale Deal"@el,
        "Atlantic Whale Deal"@en,
        "Atlantic Whale Deal"@es,
        "Atlantic Whale Deal"@fr,
        "Atlantic Whale Deal"@it,
        "Atlantic Whale Deal"@no,
        "Atlantic Whale Deal"@pt,
        "Atlantic Whale Deal"@ro ;
    schema1:endDate "2026-11-30"^^xsd:date ;
    schema1:startDate "2023-12-01"^^xsd:date ;
    skos:prefLabel "Atlantic Whale Deal"@el,
        "Atlantic Whale Deal"@en,
        "Atlantic Whale Deal"@es,
        "Atlantic Whale Deal"@fr,
        "Atlantic Whale Deal"@it,
        "Atlantic Whale Deal"@no,
        "Atlantic Whale Deal"@pt,
        "Atlantic Whale Deal"@ro ;
    foaf:homepage <https://www.atlanticarea.eu/discover-our-projects/approved-projects/atlantic-whale-deal> ;
    OSO:Project_is_led_by_an_Organization OSO:ARDITI ;
    OSO:hasCountry OSO:France,
        OSO:Ireland,
        OSO:Portugal,
        OSO:Spain ;
    OSO:hasLogo <https://github.com/emso-eric/oso-ontology/blob/31fa81e305eb2c35f5cc8e003cf578c505b8ffa1/images/AtlanticWhaleDeal.png> ;
    OSO:hasSpatialExtent OSO:AtlanticWhaleDealbbox .

