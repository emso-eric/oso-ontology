dcterms:instructionalMethod a owl:NamedIndividual ;
    rdfs:label "Instructional Method"@el,
        "Instructional Method"@en,
        "Instructional Method"@es,
        "Instructional Method"@fr,
        "Instructional Method"@it,
        "Instructional Method"@no,
        "Instructional Method"@pt,
        "Instructional Method"@ro ;
    dcam:rangeIncludes dcterms:MethodOfInstruction ;
    dcterms:description "Instructional Method typically includes ways of presenting instructional materials or conducting instructional activities, patterns of learner-to-learner and learner-to-instructor interactions, and mechanisms by which group and individual levels of learning are measured.  Instructional methods include all aspects of the instruction and learning processes from planning and implementation through evaluation and feedback."@en ;
    dcterms:issued "2005-06-13"^^xsd:date ;
    rdfs:comment "A process, used to engender knowledge, attitudes and skills, that the described resource is designed to support."@el,
        "A process, used to engender knowledge, attitudes and skills, that the described resource is designed to support."@en,
        "A process, used to engender knowledge, attitudes and skills, that the described resource is designed to support."@es,
        "A process, used to engender knowledge, attitudes and skills, that the described resource is designed to support."@fr,
        "A process, used to engender knowledge, attitudes and skills, that the described resource is designed to support."@it,
        "A process, used to engender knowledge, attitudes and skills, that the described resource is designed to support."@no,
        "A process, used to engender knowledge, attitudes and skills, that the described resource is designed to support."@pt,
        "A process, used to engender knowledge, attitudes and skills, that the described resource is designed to support."@ro ;
    rdfs:isDefinedBy dcterms: .

