        "Regional Facility is associated with a Research Infrastructure"@en,
        "La Instalación Regional está asociada con una Infraestructura de Investigación"@es,
        "L'installation régionale est associée à une infrastructure de recherche"@fr,
        "La Struttura Regionale è associata a una Infrastruttura di Ricerca"@it,
        "Regional fasilitet er knyttet til en forskningsinfrastruktur"@no,
        "A Instalação Regional está associada a uma Infraestrutura de Investigação"@pt,
        "Facilitatea regională este asociată cu o infrastructură de cercetare"@ro .

OSO:dateEndDeployment a owl:DatatypeProperty ;
    rdfs:label "Ημερομηνία λήξης εγκατάστασης"@el,
        "Deployment end date"@en,
        "Fecha de finalización del despliegue"@es,
        "Date de fin du déploiement"@fr,
        "Data di fine del dispiegamento"@it,
        "Sluttdato for utplassering"@no,
        "Data de fim da implantação"@pt,
        "Data încheierii desfășurării"@ro ;
    rdfs:comment "Ημερομηνία που σηματοδοτεί το τέλος της επιχειρησιακής εγκατάστασης ενός οργάνου, πλατφόρμας, τοποθεσίας ή υποδομής."@el,
        "Date marking the end of operational deployment of an instrument, platform, site, or infrastructure."@en,
        "Fecha que marca el final del despliegue operativo de un instrumento, plataforma, sitio o infraestructura."@es,
        "Date marquant la fin du déploiement opérationnel d’un instrument, d’une plateforme, d’un site ou d’une infrastructure."@fr,
        "Data che segna la fine del dispiegamento operativo di uno strumento, piattaforma, sito o infrastruttura."@it,
        "Dato som markerer slutten på den operative utplasseringen av et instrument, en plattform, et sted eller en infrastruktur."@no,
        "Data que marca o fim da implantação operacional de um instrumento, plataforma, local ou infraestrutura."@pt,
        "Data care marchează sfârșitul desfășurării operaționale a unui instrument, platforme, sit sau infrastructuri."@ro ;
    rdfs:domain [
        a owl:Class ;
            owl:unionOf (
            OSO:Platform
            OSO:RegionalFacility
            OSO:Site
            OSO:SubPlatform
            OSO:Subsite
            )
    ] ;
    rdfs:range [
        a rdfs:Datatype ;
        owl:unionOf (
            xsd:date
            xsd:gYearMonth
            xsd:gYear
            )
    ] ;
    rdfs:subPropertyOf schema1:endDate ;
    skos:prefLabel "Ημερομηνία λήξης εγκατάστασης"@el,
        "Deployment end date"@en,
        "Fecha de finalización del despliegue"@es,
        "Date de fin du déploiement"@fr,
        "Data di fine del dispiegamento"@it,
        "Sluttdato for utplassering"@no,
        "Data de fim da implantação"@pt,
        "Data încheierii desfășurării"@ro .

OSO:dateFirstDeployment a owl:DatatypeProperty ;
    rdfs:label "Ημερομηνία πρώτης εγκατάστασης"@el,
        "First deployment date"@en,
        "Fecha del primer despliegue"@es,
        "Date du premier déploiement"@fr,
        "Data del primo dispiegamento"@it,
        "Dato for første utplassering"@no,
        "Data da primeira implantação"@pt,
        "Data primei desfășurări operaționale"@ro ;
    rdfs:comment "Ημερομηνία της πρώτης επιχειρησιακής εγκατάστασης ενός οργάνου, πλατφόρμας, τοποθεσίας ή υποδομής."@el,
        "Date of the first operational deployment of an instrument, platform, site, or infrastructure."@en,
        "Fecha del primer despliegue operativo de un instrumento, plataforma, sitio o infraestructura."@es,
        "Date du premier déploiement opérationnel d’un instrument, d’une plateforme, d’un site ou d’une infrastructure."@fr,
        "Data del primo dispiegamento operativo di uno strumento, piattaforma, sito o infrastruttura."@it,
        "Dato for første operative utplassering av et instrument, en plattform, et sted eller en infrastruktur."@no,
        "Data da primeira implantação operacional de um instrumento, plataforma, local ou infraestrutura."@pt,
        "Data primei desfășurări operaționale a unui instrument, platforme, sit sau infrastructuri."@ro ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            OSO:Platform
            OSO:RegionalFacility
            OSO:Site
            OSO:SubPlatform
            OSO:Subsite
            )
        ] ;
    rdfs:range [
        a rdfs:Datatype ;
        owl:unionOf (
            xsd:date
            xsd:gYearMonth
            xsd:gYear
            )
        ] ;
    rdfs:subPropertyOf schema1:startDate ;
    skos:prefLabel "Ημερομηνία πρώτης εγκατάστασης"@el,
        "First deployment date"@en,
        "Fecha del primer despliegue"@es,
        "Date du premier déploiement"@fr,
        "Data del primo dispiegamento"@it,
        "Dato for første utplassering"@no,
        "Data da primeira implantação"@pt,
        "Data primei desfășurări operaționale"@ro .

OSO:distanceFromLand a owl:DatatypeProperty ;
    rdfs:label "απόσταση από την ακτή"@el,
        "distance from land"@en,
        "distancia a la costa"@es,
        "distance à la côte"@fr,
        "distanza dalla costa"@it,
        "avstand fra kysten"@no,
        "distância à costa"@pt,
        "distanța față de coastă"@ro ;
