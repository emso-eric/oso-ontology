    rdfs:comment "Απόσταση από την ακτή εκφρασμένη σε ναυτικά μίλια (NM)."@el,
        "Distance from the coastline expressed in nautical miles (NM)."@en,
        "Distancia a la costa expresada en millas náuticas (NM)."@es,
        "Distance à la côte exprimée en milles marins (NM)."@fr,
        "Distanza dalla costa espressa in miglia nautiche (NM)."@it,
        "Avstand fra kysten uttrykt i nautiske mil (NM)."@no,
        "Distância à costa expressa em milhas náuticas (NM)."@pt,
        "Distanța față de coastă exprimată în mile marine (NM)."@ro ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            OSO:RegionalFacility
            OSO:Site
            )
    ] ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "απόσταση από την ακτή"@el,
        "distance from land"@en,
        "distancia a la costa"@es,
        "distance à la côte"@fr,
        "distanza dalla costa"@it,
        "avstand fra kysten"@no,
        "distância à costa"@pt,
        "distanța față de coastă"@ro .

OSO:eastBoundLongitude a owl:DatatypeProperty ;
    rdfs:label "ανατολικό όριο γεωγραφικού μήκους"@el,
        "east bound longitude"@en,
        "longitud este máxima"@es,
        "longitude est maximale"@fr,
        "longitudine est massima"@it,
        "østlig lengdegrad"@no,
        "longitude leste máxima"@pt,
        "longitudine estică maximă"@ro ;
    rdfs:comment "Η ανατολικότερη γεωγραφική longitude ενός γεωγραφικού πλαισίου, που αντιστοιχεί στο eastBoundLongitude του ISO 19115-3."@el,
        "Easternmost longitude of a geographic bounding box, corresponding to eastBoundLongitude in ISO 19115-3."@en,
        "Longitud oriental máxima de una caja geográfica delimitadora, correspondiente a eastBoundLongitude en ISO 19115-3."@es,
        "Longitude orientale maximale d’une boîte englobante géographique, correspondant à eastBoundLongitude dans l’ISO 19115-3."@fr,
        "Longitudine orientale massima di un riquadro geografico, corrispondente a eastBoundLongitude in ISO 19115-3."@it,
        "Østligste lengdegrad i en geografisk avgrensningsboks, tilsvarende eastBoundLongitude i ISO 19115-3."@no,
        "Longitude oriental máxima de uma caixa geográfica delimitadora, correspondente a eastBoundLongitude na ISO 19115-3."@pt,
        "Longitudinea estică maximă a unei zone geografice delimitate, corespunzătoare eastBoundLongitude din ISO 19115-3."@ro ;
    rdfs:domain OSO:BoundingBox ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "ανατολικό όριο γεωγραφικού μήκους"@el,
        "east bound longitude"@en,
        "longitud este máxima"@es,
        "longitude est maximale"@fr,
