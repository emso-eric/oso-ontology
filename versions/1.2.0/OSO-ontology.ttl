OSO:SemanticTool a owl:Class ;
    rdfs:label "Σημασιολογικό εργαλείο"@el,
        "Semantic tool"@en,
        "Herramienta semántica"@es,
        "Outil sémantique"@fr,
        "Strumento semantico"@it,
        "Semantisk verktøy"@no,
        "Ferramenta semântica"@pt,
        "Instrument semantic"@ro ;
