        "contiene un sitio"@es,
        "contient un site"@fr,
        "contiene un sito"@it,
        "inneholder sted"@no,
        "contém um local"@pt,
        "conține sit"@ro .

OSO:containsSubPlatform a owl:ObjectProperty ;
    rdfs:label "περιέχει υπο-πλατφόρμα"@el,
        "contains sub-platform"@en,
        "contiene subplataforma"@es,
        "contient une sous-plateforme"@fr,
        "contiene sotto-piattaforma"@it,
        "inneholder underplattform"@no,
        "contém subplataforma"@pt,
        "conține subplatformă"@ro ;
    rdfs:comment "Συνδέει μια πλατφόρμα με μία ή περισσότερες υπο-πλατφόρμες που αποτελούν μέρος της."@el,
        "Links a platform to one or more sub-platforms that are part of it."@en,
        "Relaciona una plataforma con una o varias subplataformas que forman parte de ella."@es,
        "Relie une plateforme à une ou plusieurs sous-plateformes qui en font partie."@fr,
        "Collega una piattaforma a una o più sotto-piattaforme che ne fanno parte."@it,
        "Knytter en plattform til én eller flere underplattformer som er del av den."@no,
        "Liga uma plataforma a uma ou mais subplataformas que fazem parte dela."@pt,
        "Leagă o platformă de una sau mai multe subplatforme care fac parte din aceasta."@ro ;
    rdfs:domain OSO:Platform ;
    rdfs:range OSO:SubPlatform ;
    owl:inverseOf OSO:isSubPlatformOf ;
    skos:prefLabel "περιέχει υπο-πλατφόρμα"@el,
        "contains sub-platform"@en,
        "contiene subplataforma"@es,
        "contient une sous-plateforme"@fr,
        "contiene sotto-piattaforma"@it,
        "inneholder underplattform"@no,
        "contém subplataforma"@pt,
        "conține subplatformă"@ro .

OSO:hasBoundingBox a owl:ObjectProperty ;
    rdfs:label "έχει οριοθετημένο πλαίσιο"@el,
        "has bounding box"@en,
        "tiene caja envolvente"@es,
        "a une boîte englobante"@fr,
        "ha un riquadro di delimitazione"@it,
        "har avgrensningsboks"@no,
        "tem caixa delimitadora"@pt,
        "are bounding box"@ro ;
    rdfs:comment "Συνδέει μια περιφερειακή υποδομή με τη χωρική της έκταση, ευθυγραμμισμένη με το EX_Extent/EX_GeographicBoundingBox του ISO 19115-3."@el,
        "Links a Regional Facility to its spatial extent, aligned with EX_Extent/EX_GeographicBoundingBox in ISO 19115-3."@en,
        "Relaciona una infraestructura regional con su extensión espacial, alineada con EX_Extent/EX_GeographicBoundingBox en ISO 19115-3."@es,
        "Lie une infrastructure régionale à son emprise spatiale, alignée sur EX_Extent/EX_GeographicBoundingBox dans ISO 19115-3."@fr,
        "Collega una infrastruttura regionale alla sua estensione spaziale, allineata con EX_Extent/EX_GeographicBoundingBox in ISO 19115-3."@it,
        "Knytter en regional infrastruktur til dens geografiske utstrekning, i samsvar med EX_Extent/EX_GeographicBoundingBox i ISO 19115-3."@no,
        "Liga uma infraestrutura regional à sua extensão espacial, alinhada com EX_Extent/EX_GeographicBoundingBox na ISO 19115-3."@pt,
        "Leagă o infrastructură regională de extinderea sa spațială, aliniată cu EX_Extent/EX_GeographicBoundingBox din ISO 19115-3."@ro ;
    rdfs:domain OSO:RegionalFacility ;
    rdfs:range OSO:BoundingBox ;
    owl:inverseOf OSO:isBoundingBoxOf ;
    skos:prefLabel "έχει οριοθετημένο πλαίσιο"@el,
        "has bounding box"@en,
        "tiene caja envolvente"@es,
        "a une boîte englobante"@fr,
        "ha un riquadro di delimitazione"@it,
        "har avgrensningsboks"@no,
        "tem caixa delimitadora"@pt,
        "are bounding box"@ro .

OSO:hasCountry a owl:ObjectProperty ;
    rdfs:label "έχει χώρα"@el,
        "has country"@en,
        "tiene país"@es,
        "a pour pays"@fr,
        "ha paese"@it,
        "har land"@no,
        "tem país"@pt,
        "are țară"@ro ;
    rdfs:comment "Συνδέει έναν οργανισμό ή μια ερευνητική υποδομή με τη σχετική χώρα."@el,
        "Links an organisation or research infrastructure to its associated country."@en,
        "Relaciona una organización o infraestructura de investigación con su país asociado."@es,
        "Lie une organisation ou une infrastructure de recherche à son pays associé."@fr,
        "Collega un'organizzazione o infrastruttura di ricerca al paese associato."@it,
        "Knytter en organisasjon eller forskningsinfrastruktur til tilhørende land."@no,
        "Liga uma organização ou infraestrutura de investigação ao país associado."@pt,
        "Leagă o organizație sau infrastructură de cercetare de țara asociată."@ro ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            foaf:Organization
            OSO:RegionalFacility
            OSO:ResearchInfrastructure
            )
    ] ;
    rdfs:range <http://dbpedia.org/ontology/Country> ;
    rdfs:subPropertyOf schema1:addressCountry ;
    owl:inverseOf OSO:isCountryOf ;
    skos:prefLabel "έχει χώρα"@el,
        "has country"@en,
        "tiene país"@es,
        "a pour pays"@fr,
        "ha paese"@it,
        "har land"@no,
        "tem país"@pt,
