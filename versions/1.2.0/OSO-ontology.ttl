    rdfs:range xsd:decimal ;
    skos:definition "Καθορίζει το βορειότερο γεωγραφικό πλάτος ενός γεωγραφικού πλαισίου."@el,
        "Specifies the northernmost latitude of a geographic bounding box."@en,
        "Especifica la latitud norte máxima de una caja geográfica delimitadora."@es,
        "Spécifie la latitude nord maximale d’une boîte englobante géographique."@fr,
        "Specifica la latitudine nord massima di un riquadro geografico."@it,
        "Angir den nordligste breddegraden i en geografisk avgrensningsboks."@no,
        "Especifica a latitude norte máxima de uma caixa geográfica delimitadora."@pt,
        "Specifică latitudinea nordică maximă a unei zone geografice delimitate."@ro ;
    skos:prefLabel "βόρειο όριο γεωγραφικού πλάτους"@el,
        "northBoundLatitude"@en,
        "latitud norte máxima"@es,
        "latitude nord maximale"@fr,
        "latitudine nord massima"@it,
        "nordlig breddegrad"@no,
        "latitude norte máxima"@pt,
        "latitudine nordică maximă"@ro .

