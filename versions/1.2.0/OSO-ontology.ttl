OSO:CollaborativeDevelopmentPlatform a owl:Class ;
    rdfs:label "Πλατφόρμα συνεργατικής ανάπτυξης"@el,
        "Collaborative development platform"@en,
        "Plataforma de desarrollo colaborativo"@es,
        "Plateforme de développement collaboratif"@fr,
        "Piattaforma di sviluppo collaborativo"@it,
        "Plattform for samarbeidsutvikling"@no,
        "Plataforma de desenvolvimento colaborativo"@pt,
        "Platformă de dezvoltare colaborativă"@ro ;
    rdfs:subClassOf OSO:SemanticTool ;
    skos:definition "Μια πλατφόρμα λογισμικού που υποστηρίζει τη συνεργατική ανάπτυξη λογισμικού, τον έλεγχο εκδόσεων, την παρακολούθηση ζητημάτων και τη διαχείριση πηγαίου κώδικα."@el,
        "A software platform supporting collaborative software development, version control, issue tracking and source code management."@en,
        "Una plataforma de software que permite el desarrollo colaborativo, el control de versiones, el seguimiento de incidencias y la gestión del código fuente."@es,
        "Une plateforme logicielle prenant en charge le développement collaboratif, le contrôle de version, le suivi des tickets et la gestion du code source."@fr,
        "Una piattaforma software che supporta lo sviluppo collaborativo, il controllo di versione, il tracciamento delle issue e la gestione del codice sorgente."@it,
        "En programvareplattform som støtter samarbeidsbasert programvareutvikling, versjonskontroll, saksoppfølging og håndtering av kildekode."@no,
        "Uma plataforma de software que suporta o desenvolvimento colaborativo, o controlo de versões, o acompanhamento de problemas e a gestão do código-fonte."@pt,
        "O platformă software care sprijină dezvoltarea colaborativă, controlul versiunilor, urmărirea problemelor și gestionarea codului sursă."@ro .

OSO:Discipline a owl:Class ;
    rdfs:label "Επιστημονικός κλάδος"@el,
        "Discipline"@en,
        "Disciplina"@es,
        "Discipline"@fr,
        "Disciplina"@it,
        "Disiplin"@no,
        "Disciplina"@pt,
        "Disciplină"@ro ;
    metadata:prefixIRI "Discipline",
        "omv:Discipline" ;
    rdfs:comment "Λίστα των επιστημονικών κλάδων του EMSO που σχετίζονται με μια Περιφερειακή Εγκατάσταση."@el,
        "List of EMSO scientific disciplines associated with a Regional Facility."@en,
        "Lista de disciplinas científicas de EMSO asociadas a una Instalación Regional."@es,
        "Liste des disciplines scientifiques EMSO associées à une installation régionale."@fr,
        "Elenco delle discipline scientifiche EMSO associate a una Struttura Regionale."@it,
        "Liste over EMSO-vitenskapelige disipliner knyttet til en regional fasilitet."@no,
        "Lista das disciplinas científicas da EMSO associadas a uma Instalação Regional."@pt,
        "Listă a disciplinelor științifice EMSO asociate unei facilități regionale."@ro ;
    rdfs:subClassOf owl:Thing ;
    skos:prefLabel "Επιστημονικός κλάδος"@el,
        "Discipline"@en,
        "Disciplina"@es,
        "Discipline"@fr,
        "Disciplina"@it,
        "Disiplin"@no,
        "Disciplina"@pt,
        "Disciplină"@ro .

OSO:FAIRAssessmentTool a owl:Class ;
    rdfs:label "Εργαλείο αξιολόγησης FAIR"@el,
        "FAIR assessment tool"@en,
        "Herramienta de evaluación FAIR"@es,
        "Outil d'évaluation FAIR"@fr,
        "Strumento di valutazione FAIR"@it,
        "FAIR-evalueringsverktøy"@no,
        "Ferramenta de avaliação FAIR"@pt,
        "Instrument de evaluare FAIR"@ro ;
    rdfs:subClassOf OSO:SemanticTool ;
    skos:definition "Ένα εργαλείο λογισμικού που χρησιμοποιείται για την αξιολόγηση του επιπέδου FAIR σημασιολογικών τεχνουργημάτων."@el,
        "A software tool used to assess the FAIRness of semantic artefacts."@en,
        "Una herramienta de software utilizada para evaluar el grado de conformidad FAIR de artefactos semánticos."@es,
        "Un outil logiciel utilisé pour évaluer le niveau de conformité FAIR d'artefacts sémantiques."@fr,
        "Uno strumento software utilizzato per valutare il livello di conformità FAIR degli artefatti semantici."@it,
        "Et programvareverktøy som brukes til å evaluere FAIR-nivået til semantiske artefakter."@no,
        "Uma ferramenta de software utilizada para avaliar o nível de conformidade FAIR de artefactos semânticos."@pt,
        "Un instrument software utilizat pentru evaluarea nivelului de conformitate FAIR al artefactelor semantice."@ro .

OSO:ObsoleteClass a owl:Class ;
    rdfs:label "Παρωχημένη κλάση"@el,
        "Obsolete class"@en,
        "Clase obsoleta"@es,
        "Classe obsolète"@fr,
        "Classe obsoleta"@it,
        "Foreldet klasse"@no,
        "Classe obsoleta"@pt,
        "Clasă învechită"@ro ;
    rdfs:comment "Ριζική κλάση που ομαδοποιεί τις παρωχημένες κλάσεις του OSO."@el,
        "Root class grouping deprecated OSO classes."@en,
        "Clase raíz que agrupa las clases OSO obsoletas."@es,
        "Classe racine regroupant les classes OSO obsolètes."@fr,
        "Classe radice che raggruppa le classi OSO obsolete."@it,
        "Rotklasse som grupperer foreldede OSO-klasser."@no,
        "Classe raiz que agrupa as classes OSO obsoletas."@pt,
        "Clasă rădăcină care grupează clasele OSO învechite."@ro ;
    skos:note "Αυτή η κλάση δεν χρησιμοποιείται επί του παρόντος, αλλά προορίζεται για μελλοντική εξέλιξη της οντολογίας."@el,
        "This class is currently not used but reserved for future ontology evolution."@en,
        "Esta clase no se utiliza actualmente pero está reservada para una evolución futura de la ontología."@es,
        "Cette classe n’est actuellement pas utilisée mais est réservée pour une évolution future de l’ontologie."@fr,
        "Questa classe non è attualmente utilizzata ma è riservata per una futura evoluzione dell’ontologia."@it,
        "Denne klassen brukes for øyeblikket ikke, men er reservert for fremtidig utvikling av ontologien."@no,
        "Esta classe não é atualmente utilizada, mas está reservada para futura evolução da ontologia."@pt,
        "Această clasă nu este utilizată în prezent, dar este rezervată pentru evoluția viitoare a ontologiei."@ro ;
    skos:prefLabel "Παρωχημένη κλάση"@el,
        "Obsolete class"@en,
        "Clase obsoleta"@es,
        "Classe obsolète"@fr,
        "Classe obsoleta"@it,
        "Foreldet klasse"@no,
        "Classe obsoleta"@pt,
        "Clasă învechită"@ro ;
    adms:status <http://purl.org/adms/status/UnderDevelopment> .

OSO:Ocean_Data_Acquisition_System a owl:Class ;
    rdfs:label "Ocean Data Acquisition System"@en ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Ocean_data_acquisition_system>,
        <https://unesdoc.unesco.org/ark:/48223/pf0000023696> ;
    rdfs:subClassOf OSO:Platform ;
    skos:altLabel "ODAS"@en ;
    skos:definition "A general type of oceanographic data acquisition system used for marine observations."@en ;
    skos:prefLabel "Ocean Data Acquisition System"@en .

OSO:OntologyEditor a owl:Class ;
    rdfs:label "Επεξεργαστής οντολογιών"@el,
        "Ontology editor"@en,
        "Editor de ontologías"@es,
        "Éditeur d'ontologies"@fr,
        "Editor di ontologie"@it,
        "Ontologiredigeringsverktøy"@no,
        "Editor de ontologias"@pt,
        "Editor de ontologii"@ro ;
    rdfs:subClassOf OSO:SemanticTool ;
    skos:definition "Ένα σημασιολογικό εργαλείο που χρησιμοποιείται για τη δημιουργία, την επεξεργασία και τη συντήρηση οντολογιών."@el,
        "A semantic tool used to create, edit and maintain ontologies."@en,
        "Una herramienta semántica utilizada para crear, editar y mantener ontologías."@es,
        "Un outil sémantique utilisé pour créer, éditer et maintenir des ontologies."@fr,
        "Uno strumento semantico utilizzato per creare, modificare e mantenere ontologie."@it,
        "Et semantisk verktøy som brukes til å opprette, redigere og vedlikeholde ontologier."@no,
        "Uma ferramenta semântica utilizada para criar, editar e manter ontologias."@pt,
        "Un instrument semantic utilizat pentru crearea, editarea și întreținerea ontologiilor."@ro .

OSO:Project_is_led_by_an_Organization a owl:ObjectProperty ;
    rdfs:label "Το έργο διευθύνεται από οργανισμό"@el,
        "Project is led by an organisation"@en,
        "El proyecto está dirigido por una organización"@es,
        "Le projet est dirigé par une organisation"@fr,
        "Il progetto è guidato da un'organizzazione"@it,
        "Prosjektet ledes av en organisasjon"@no,
        "O projeto é liderado por uma organização"@pt,
        "Proiectul este coordonat de o organizație"@ro ;
    rdfs:comment "Υποδεικνύει τον οργανισμό που είναι υπεύθυνος για τη διεύθυνση ή τον συντονισμό ενός ερευνητικού έργου."@el,
        "Indicates the organization responsible for leading or coordinating a research project."@en,
        "Indica la organización responsable de dirigir o coordinar un proyecto de investigación."@es,
        "Indique l'organisation responsable de la direction ou de la coordination d’un projet de recherche."@fr,
        "Indica l'organizzazione responsabile della direzione o del coordinamento di un progetto di ricerca."@it,
        "Angir organisasjonen som er ansvarlig for å lede eller koordinere et forskningsprosjekt."@no,
        "Indica a organização responsável pela liderança ou coordenação de um projeto de investigação."@pt,
        "Indică organizația responsabilă de coordonarea sau conducerea unui proiect de cercetare."@ro ;
    rdfs:domain OSO:ResearchProject ;
    rdfs:range foaf:Organization ;
    skos:definition "Συνδέει ένα ερευνητικό έργο με τον οργανισμό που είναι υπεύθυνος για τη διεύθυνση ή τον συντονισμό του."@el,
        "Relates a research project to the organisation responsible for leading or coordinating it."@en,
        "Relaciona un proyecto de investigación con la organización responsable de liderarlo o coordinarlo."@es,
        "Relie un projet de recherche à l’organisation responsable de sa direction ou de sa coordination."@fr,
        "Collega un progetto di ricerca all'organizzazione responsabile della sua direzione o coordinamento."@it,
        "Knytter et forskningsprosjekt til organisasjonen som leder eller koordinerer det."@no,
        "Liga um projeto de investigação à organização responsável pela sua coordenação ou liderança."@pt,
        "Leagă un proiect de cercetare de organizația responsabilă de coordonarea sau conducerea acestuia."@ro ;
    skos:prefLabel "Το έργο διευθύνεται από οργανισμό"@el,
        "Project is led by an organisation"@en,
        "El proyecto está dirigido por una organización"@es,
        "Le projet est dirigé par une organisation"@fr,
        "Il progetto è guidato da un'organizzazione"@it,
        "Prosjektet ledes av en organisasjon"@no,
        "O projeto é liderado por uma organização"@pt,
        "Proiectul este coordonat de o organizație"@ro .

OSO:RDFFramework a owl:Class ;
    rdfs:label "Πλαίσιο RDF"@el,
        "RDF framework"@en,
        "Framework RDF"@es,
        "Framework RDF"@fr,
        "Framework RDF"@it,
        "RDF-rammeverk"@no,
        "Framework RDF"@pt,
        "Cadru RDF"@ro ;
    rdfs:subClassOf OSO:SemanticTool ;
    skos:definition "Ένα πλαίσιο λογισμικού που χρησιμοποιείται για τη δημιουργία, την ανάλυση, τον χειρισμό, τη σειριοποίηση ή την επικύρωση γράφων RDF."@el,
        "A software framework used to create, parse, manipulate, serialize or validate RDF graphs."@en,
        "Un framework software utilizado para crear, analizar, manipular, serializar o validar grafos RDF."@es,
        "Un framework logiciel utilisé pour créer, analyser, manipuler, sérialiser ou valider des graphes RDF."@fr,
        "Un framework software utilizzato per creare, analizzare, manipolare, serializzare o validare grafi RDF."@it,
        "Et programvarerammeverk som brukes til å opprette, analysere, manipulere, serialisere eller validere RDF-grafer."@no,
        "Um framework de software utilizado para criar, analisar, manipular, serializar ou validar grafos RDF."@pt,
        "Un cadru software utilizat pentru crearea, parsarea, manipularea, serializarea sau validarea grafurilor RDF."@ro .

OSO:RegionalFacility_is_linked_to_a_project a owl:ObjectProperty ;
    rdfs:label "Η περιφερειακή υποδομή συνδέεται με έργο"@el,
        "Regional Facility is linked to a project"@en,
        "La infraestructura regional está vinculada a un proyecto"@es,
        "L’infrastructure régionale est liée à un projet"@fr,
        "L'infrastruttura regionale è collegata a un progetto"@it,
        "Regional infrastruktur er knyttet til et prosjekt"@no,
        "A infraestrutura regional está ligada a um projeto"@pt,
        "Infrastructura regională este legată de un proiect"@ro ;
    rdfs:comment "Συνδέει μια περιφερειακή υποδομή με ένα σχετικό ερευνητικό έργο."@el,
        "Links a regional facility to a related research project."@en,
        "Relaciona una infraestructura regional con un proyecto de investigación asociado."@es,
        "Lie une infrastructure régionale à un projet de recherche associé."@fr,
        "Collega un'infrastruttura regionale a un progetto di ricerca associato."@it,
        "Knytter en regional infrastruktur til et tilknyttet forskningsprosjekt."@no,
        "Liga uma infraestrutura regional a um projeto de investigação associado."@pt,
        "Leagă o infrastructură regională de un proiect de cercetare asociat."@ro ;
    rdfs:domain OSO:RegionalFacility ;
    rdfs:range OSO:ResearchProject ;
    skos:definition "Συνδέει μια περιφερειακή υποδομή με ένα ερευνητικό έργο με το οποίο σχετίζεται."@el,
        "Relates a regional facility to a research project with which it is associated."@en,
        "Relaciona una infraestructura regional con un proyecto de investigación al que está asociada."@es,
        "Relie une infrastructure régionale à un projet de recherche auquel elle est associée."@fr,
        "Collega un'infrastruttura regionale a un progetto di ricerca a cui è associata."@it,
        "Knytter en regional infrastruktur til et forskningsprosjekt som den er tilknyttet."@no,
        "Liga uma infraestrutura regional a um projeto de investigação ao qual está associada."@pt,
        "Leagă o infrastructură regională de un proiect de cercetare cu care este asociată."@ro ;
    skos:prefLabel "Η περιφερειακή υποδομή συνδέεται με έργο"@el,
        "Regional Facility is linked to a project"@en,
        "La infraestructura regional está vinculada a un proyecto"@es,
        "L’infrastructure régionale est liée à un projet"@fr,
        "L'infrastruttura regionale è collegata a un progetto"@it,
        "Regional infrastruktur er knyttet til et prosjekt"@no,
        "A infraestrutura regional está ligada a um projeto"@pt,
        "Infrastructura regională este legată de un proiect"@ro .

OSO:RegionalFacility_is_part_of_a_RI a owl:ObjectProperty ;
    rdfs:label "Η περιφερειακή υποδομή αποτελεί μέρος ερευνητικής υποδομής"@el,
        "Regional Facility is part of a Research Infrastructure"@en,
        "La infraestructura regional forma parte de una infraestructura de investigación"@es,
        "L’infrastructure régionale fait partie d’une infrastructure de recherche"@fr,
        "L'infrastruttura regionale fa parte di un'infrastruttura di ricerca"@it,
        "Regional infrastruktur er del av en forskningsinfrastruktur"@no,
        "A infraestrutura regional faz parte de uma infraestrutura de investigação"@pt,
        "Infrastructura regională face parte dintr-o infrastructură de cercetare"@ro ;
    rdfs:comment "Συνδέει μια περιφερειακή υποδομή με τη μητρική της ερευνητική υποδομή."@el,
        "Links a regional facility to its parent research infrastructure."@en,
        "Relaciona una infraestructura regional con su infraestructura de investigación principal."@es,
        "Lie une infrastructure régionale à son infrastructure de recherche parente."@fr,
        "Collega un'infrastruttura regionale alla sua infrastruttura di ricerca principale."@it,
        "Knytter en regional infrastruktur til dens overordnede forskningsinfrastruktur."@no,
        "Liga uma infraestrutura regional à sua infraestrutura de investigação principal."@pt,
        "Leagă o infrastructură regională de infrastructura sa principală de cercetare."@ro ;
    rdfs:domain OSO:RegionalFacility ;
    rdfs:range OSO:ResearchInfrastructure ;
    owl:inverseOf OSO:hasRegionalFacility ;
    skos:definition "Συνδέει μια περιφερειακή υποδομή με την ερευνητική υποδομή της οποίας αποτελεί μέρος."@el,
        "Relates a regional facility to the research infrastructure of which it is part."@en,
        "Relaciona una infraestructura regional con la infraestructura de investigación de la que forma parte."@es,
        "Relie une infrastructure régionale à l’infrastructure de recherche dont elle fait partie."@fr,
        "Collega un'infrastruttura regionale all'infrastruttura di ricerca di cui fa parte."@it,
        "Knytter en regional infrastruktur til forskningsinfrastrukturen den er en del av."@no,
        "Liga uma infraestrutura regional à infraestrutura de investigação da qual faz parte."@pt,
        "Leagă o infrastructură regională de infrastructura de cercetare din care face parte."@ro ;
    skos:prefLabel "Η περιφερειακή υποδομή αποτελεί μέρος ερευνητικής υποδομής"@el,
        "Regional Facility is part of a Research Infrastructure"@en,
        "La infraestructura regional forma parte de una infraestructura de investigación"@es,
        "L’infrastructure régionale fait partie d’une infrastructure de recherche"@fr,
        "L'infrastruttura regionale fa parte di un'infrastruttura di ricerca"@it,
        "Regional infrastruktur er del av en forskningsinfrastruktur"@no,
        "A infraestrutura regional faz parte de uma infraestrutura de investigação"@pt,
        "Infrastructura regională face parte dintr-o infrastructură de cercetare"@ro .

OSO:RegionalFacility_is_related_to_RI a owl:ObjectProperty ;
    rdfs:label "Η περιφερειακή υποδομή σχετίζεται με ερευνητική υποδομή"@el,
        "Regional Facility is related to a Research Infrastructure"@en,
        "La infraestructura regional está relacionada con una infraestructura de investigación"@es,
        "L’infrastructure régionale est liée à une infrastructure de recherche"@fr,
        "L'infrastruttura regionale è collegata a un'infrastruttura di ricerca"@it,
        "Regional infrastruktur er relatert til en forskningsinfrastruktur"@no,
        "A infraestrutura regional está relacionada com uma infraestrutura de investigação"@pt,
        "Infrastructura regională este legată de o infrastructură de cercetare"@ro ;
    rdfs:comment "Μια περιφερειακή υποδομή μπορεί να σχετίζεται με μία ή περισσότερες ερευνητικές υποδομές χωρίς επίσημη σχέση μέρους-όλου."@el,
        "A regional facility may be related to one or more research infrastructures without a formal part-whole relationship."@en,
        "Una infraestructura regional puede estar relacionada con una o varias infraestructuras de investigación sin una relación formal de pertenencia."@es,
        "Une infrastructure régionale peut être liée à une ou plusieurs infrastructures de recherche sans relation formelle de composition."@fr,
        "Un'infrastruttura regionale può essere collegata a una o più infrastrutture di ricerca senza una relazione formale di appartenenza."@it,
        "En regional infrastruktur kan være knyttet til en eller flere forskningsinfrastrukturer uten et formelt del-forhold."@no,
        "Uma infraestrutura regional pode estar relacionada com uma ou mais infraestruturas de investigação sem uma relação formal de pertença."@pt,
        "O infrastructură regională poate fi legată de una sau mai multe infrastructuri de cercetare fără o relație formală de apartenență."@ro ;
    rdfs:domain OSO:RegionalFacility ;
    rdfs:range OSO:ResearchInfrastructure ;
    skos:definition "Συνδέει μια περιφερειακή υποδομή με μια ερευνητική υποδομή με την οποία έχει σχέση, χωρίς απαραίτητα να αποτελεί επίσημα μέρος της."@el,
        "Relates a regional facility to a research infrastructure with which it has an association, without necessarily being formally part of it."@en,
        "Relaciona una infraestructura regional con una infraestructura de investigación con la que mantiene una asociación, sin formar necesariamente parte formal de ella."@es,
        "Relie une infrastructure régionale à une infrastructure de recherche avec laquelle elle possède une association, sans nécessairement en faire formellement partie."@fr,
        "Collega un'infrastruttura regionale a un'infrastruttura di ricerca con cui ha un'associazione, senza necessariamente farne formalmente parte."@it,
        "Knytter en regional infrastruktur til en forskningsinfrastruktur som den har en tilknytning til, uten nødvendigvis å være formelt en del av den."@no,
        "Liga uma infraestrutura regional a uma infraestrutura de investigação com a qual possui uma associação, sem necessariamente fazer formalmente parte dela."@pt,
        "Leagă o infrastructură regională de o infrastructură de cercetare cu care are o asociere, fără a face neapărat parte oficial din aceasta."@ro ;
    skos:prefLabel "Η περιφερειακή υποδομή σχετίζεται με ερευνητική υποδομή"@el,
        "Regional Facility is related to a Research Infrastructure"@en,
        "La infraestructura regional está relacionada con una infraestructura de investigación"@es,
        "L’infrastructure régionale est liée à une infrastructure de recherche"@fr,
        "L'infrastruttura regionale è collegata a un'infrastruttura di ricerca"@it,
        "Regional infrastruktur er relatert til en forskningsinfrastruktur"@no,
        "A infraestrutura regional está relacionada com uma infraestrutura de investigação"@pt,
        "Infrastructura regională este legată de o infrastructură de cercetare"@ro .

OSO:SPARQLService a owl:Class ;
    rdfs:label "Υπηρεσία SPARQL"@el,
        "SPARQL service"@en,
        "Servicio SPARQL"@es,
        "Service SPARQL"@fr,
        "Servizio SPARQL"@it,
        "SPARQL-tjeneste"@no,
        "Serviço SPARQL"@pt,
        "Serviciu SPARQL"@ro ;
    rdfs:subClassOf OSO:SemanticTool ;
    skos:definition "Μια υπηρεσία που εκθέτει δεδομένα RDF μέσω της γλώσσας ερωτημάτων SPARQL."@el,
        "A service exposing RDF data through the SPARQL query language."@en,
        "Un servicio que expone datos RDF mediante el lenguaje de consulta SPARQL."@es,
        "Un service exposant des données RDF via le langage de requête SPARQL."@fr,
        "Un servizio che espone dati RDF attraverso il linguaggio di interrogazione SPARQL."@it,
        "En tjeneste som eksponerer RDF-data gjennom spørrespråket SPARQL."@no,
        "Um serviço que expõe dados RDF através da linguagem de consulta SPARQL."@pt,
        "Un serviciu care expune date RDF prin intermediul limbajului de interogare SPARQL."@ro .

OSO:SemanticDatabase a owl:Class ;
    rdfs:label "Σημασιολογική βάση δεδομένων"@el,
        "Semantic database"@en,
        "Base de datos semántica"@es,
        "Base de données sémantique"@fr,
        "Base di dati semantica"@it,
        "Semantisk database"@no,
        "Base de dados semântica"@pt,
        "Bază de date semantică"@ro ;
    rdfs:subClassOf schema1:SoftwareApplication,
        OSO:SemanticTool ;
    skos:definition "Ένα λογισμικό σύστημα σχεδιασμένο για την αποθήκευση, διαχείριση και υποβολή ερωτημάτων σε σημασιολογικά δεδομένα, όπως γράφοι RDF και γράφοι γνώσης."@el,
        "A software system designed to store, manage and query semantic data such as RDF graphs and knowledge graphs."@en,
        "Un sistema de software diseñado para almacenar, gestionar y consultar datos semánticos como grafos RDF y grafos de conocimiento."@es,
        "Un système logiciel conçu pour stocker, gérer et interroger des données sémantiques telles que des graphes RDF et des graphes de connaissances."@fr,
        "Un sistema software progettato per archiviare, gestire e interrogare dati semantici come grafi RDF e grafi della conoscenza."@it,
        "Et programvaresystem utviklet for å lagre, administrere og spørre semantiske data som RDF-grafer og kunnskapsgrafer."@no,
        "Um sistema de software concebido para armazenar, gerir e consultar dados semânticos, como grafos RDF e grafos de conhecimento."@pt,
        "Un sistem software conceput pentru stocarea, gestionarea și interogarea datelor semantice, precum grafuri RDF și grafuri de cunoștințe."@ro .

OSO:SemanticDocumentationTool a owl:Class ;
    rdfs:label "Εργαλείο σημασιολογικής τεκμηρίωσης"@el,
        "Semantic documentation tool"@en,
        "Herramienta de documentación semántica"@es,
        "Outil de documentation sémantique"@fr,
        "Strumento di documentazione semantica"@it,
        "Verktøy for semantisk dokumentasjon"@no,
        "Ferramenta de documentação semântica"@pt,
        "Instrument de documentare semantică"@ro ;
    rdfs:subClassOf OSO:SemanticTool ;
    skos:definition "Ένα εργαλείο που χρησιμοποιείται για τη δημιουργία τεκμηρίωσης για σημασιολογικά τεχνουργήματα."@el,
        "A tool used to generate documentation for semantic artefacts."@en,
        "Una herramienta utilizada para generar documentación para artefactos semánticos."@es,
        "Un outil utilisé pour générer la documentation d'artefacts sémantiques."@fr,
        "Uno strumento utilizzato per generare documentazione per artefatti semantici."@it,
        "Et verktøy som brukes til å generere dokumentasjon for semantiske artefakter."@no,
        "Uma ferramenta utilizada para gerar documentação para artefactos semânticos."@pt,
        "Un instrument utilizat pentru generarea documentației pentru artefacte semantice."@ro .

OSO:SemanticPortalFramework a owl:Class ;
    rdfs:label "Πλαίσιο για σημασιολογικές πύλες"@el,
        "Semantic portal framework"@en,
        "Framework para portales semánticos"@es,
        "Framework de portail sémantique"@fr,
        "Framework per portali semantici"@it,
        "Rammeverk for semantiske portaler"@no,
        "Framework para portais semânticos"@pt,
        "Framework pentru portaluri semantice"@ro ;
    rdfs:subClassOf OSO:SemanticTool ;
    skos:definition "Ένα πλαίσιο λογισμικού που χρησιμοποιείται για την ανάπτυξη, την εγκατάσταση και τη διαχείριση αποθετηρίων σημασιολογικών τεχνουργημάτων και πυλών οντολογιών."@el,
        "A software framework used to build, deploy and manage semantic artefact repositories and ontology portals."@en,
        "Un framework de software utilizado para crear, desplegar y administrar repositorios de artefactos semánticos y portales de ontologías."@es,
        "Un framework logiciel utilisé pour construire, déployer et administrer des dépôts d’artefacts sémantiques et des portails d’ontologies."@fr,
        "Un framework software utilizzato per creare, distribuire e gestire repository di artefatti semantici e portali di ontologie."@it,
        "Et programvarerammeverk som brukes til å bygge, distribuere og administrere semantiske artefaktlagre og ontologiportaler."@no,
        "Um framework de software utilizado para construir, implementar e gerir repositórios de artefactos semânticos e portais de ontologias."@pt,
        "Un framework software utilizat pentru construirea, implementarea și administrarea depozitelor de artefacte semantice și a portalurilor de ontologii."@ro .

OSO:SemanticRepository a owl:Class ;
    rdfs:label "Σημασιολογικό αποθετήριο"@el,
        "Semantic repository"@en,
        "Repositorio semántico"@es,
        "Dépôt sémantique"@fr,
        "Repository semantico"@it,
        "Semantisk repositorium"@no,
        "Repositório semântico"@pt,
        "Depozit semantic"@ro ;
    rdfs:subClassOf dcat:Catalog,
        OSO:SemanticEcosystemResource ;
    skos:definition "Ένας κατάλογος ή αποθετήριο που χρησιμοποιείται για τη δημοσίευση, την ευρετηρίαση, την ανακάλυψη και την ανταλλαγή σημασιολογικών τεχνουργημάτων."@el,
        "A catalogue or repository used to publish, index, discover and share semantic artefacts."@en,
        "Un catálogo o repositorio utilizado para publicar, indexar, descubrir y compartir artefactos semánticos."@es,
        "Un catalogue ou dépôt utilisé pour publier, indexer, découvrir et partager des artefacts sémantiques."@fr,
        "Un catalogo o repository utilizzato per pubblicare, indicizzare, scoprire e condividere artefatti semantici."@it,
        "Et katalog eller repositorium som brukes til å publisere, indeksere, oppdage og dele semantiske artefakter."@no,
        "Um catálogo ou repositório utilizado para publicar, indexar, descobrir e partilhar artefactos semânticos."@pt,
        "Un catalog sau depozit utilizat pentru publicarea, indexarea, descoperirea și partajarea artefactelor semantice."@ro .

OSO:SemanticVisualizationTool a owl:Class ;
    rdfs:label "Εργαλείο σημασιολογικής απεικόνισης"@el,
        "Semantic visualization tool"@en,
        "Herramienta de visualización semántica"@es,
        "Outil de visualisation sémantique"@fr,
        "Strumento di visualizzazione semantica"@it,
        "Verktøy for semantisk visualisering"@no,
        "Ferramenta de visualização semântica"@pt,
        "Instrument de vizualizare semantică"@ro ;
    rdfs:subClassOf OSO:SemanticTool ;
    skos:definition "Ένα εργαλείο που χρησιμοποιείται για την απεικόνιση σημασιολογικών τεχνουργημάτων, γράφων RDF ή δομών οντολογιών."@el,
        "A tool used to visualize semantic artefacts, RDF graphs or ontology structures."@en,
        "Una herramienta utilizada para visualizar artefactos semánticos, grafos RDF o estructuras de ontologías."@es,
        "Un outil utilisé pour visualiser des artefacts sémantiques, des graphes RDF ou des structures d'ontologies."@fr,
        "Uno strumento utilizzato per visualizzare artefatti semantici, grafi RDF o strutture di ontologie."@it,
        "Et verktøy som brukes til å visualisere semantiske artefakter, RDF-grafer eller ontologistrukturer."@no,
        "Uma ferramenta utilizada para visualizar artefactos semânticos, grafos RDF ou estruturas de ontologias."@pt,
        "Un instrument utilizat pentru vizualizarea artefactelor semantice, a grafurilor RDF sau a structurilor de ontologii."@ro .

OSO:Site_is_part_of_a_RI a owl:ObjectProperty ;
    rdfs:label "Ο σταθμός αποτελεί μέρος μιας Ερευνητικής Υποδομής"@el,
        "Site is part of a Research Infrastructure"@en,
        "El sitio forma parte de una Infraestructura de Investigación"@es,
