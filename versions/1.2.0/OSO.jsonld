    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "el",
        "@value": "Μια συνεργατική ροή εργασίας για τη μηχανική οντολογιών που υποστηρίζει την ανάπτυξη, τη συντήρηση, την έκδοση και τη FAIR δημοσίευση της Observatories of the Seas Ontology (OSO) στο σημασιολογικό οικοσύστημα του EMSO."
      },
      {
        "@language": "fr",
        "@value": "Un workflow collaboratif d’ingénierie ontologique soutenant le développement, la maintenance, le versionnement et la publication FAIR de l’Observatories of the Seas Ontology (OSO) au sein de l’écosystème sémantique EMSO."
      },
      {
        "@language": "no",
        "@value": "En samarbeidsbasert arbeidsflyt for ontologiteknikk som støtter utvikling, vedlikehold, versjonering og FAIR-publisering av Observatories of the Seas Ontology (OSO) i EMSOs semantiske økosystem."
      },
      {
        "@language": "en",
        "@value": "A collaborative ontology engineering workflow supporting the development, maintenance, versioning and FAIR publication of the Observatories of the Seas Ontology (OSO) within the EMSO semantic ecosystem."
      },
      {
        "@language": "es",
        "@value": "Un flujo de trabajo colaborativo de ingeniería ontológica que apoya el desarrollo, mantenimiento, versionado y publicación FAIR de la Observatories of the Seas Ontology (OSO) dentro del ecosistema semántico de EMSO."
      },
      {
        "@language": "pt",
        "@value": "Um fluxo de trabalho colaborativo de engenharia ontológica que apoia o desenvolvimento, a manutenção, o versionamento e a publicação FAIR da Observatories of the Seas Ontology (OSO) no ecossistema semântico do EMSO."
      },
      {
        "@language": "ro",
        "@value": "Un flux de lucru colaborativ pentru ingineria ontologiilor care sprijină dezvoltarea, întreținerea, versionarea și publicarea FAIR a Observatories of the Seas Ontology (OSO) în cadrul ecosistemului semantic EMSO."
      },
      {
        "@language": "it",
        "@value": "Un flusso di lavoro collaborativo di ingegneria ontologica che supporta lo sviluppo, la manutenzione, il versionamento e la pubblicazione FAIR della Observatories of the Seas Ontology (OSO) nell’ecosistema semantico di EMSO."
      }
    ],
