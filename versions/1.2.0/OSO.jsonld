      },
      {
        "@language": "el",
        "@value": "Συνεργατική ροή εργασίας για τη μηχανική οντολογιών"
      },
      {
        "@language": "it",
        "@value": "Flusso di lavoro collaborativo di ingegneria ontologica"
      },
      {
