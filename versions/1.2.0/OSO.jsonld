    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Responsable del Grupo de Servicios de Gestión de Datos de EMSO, encargado de la gestión de datos, la interoperabilidad y las prácticas FAIR dentro de la comunidad EMSO."
      },
      {
        "@language": "el",
        "@value": "Επικεφαλής της Ομάδας Υπηρεσιών Διαχείρισης Δεδομένων του EMSO (EMSO Data Management Service Group), υπεύθυνος για τη διαχείριση δεδομένων, τη διαλειτουργικότητα και τις πρακτικές FAIR στην κοινότητα του EMSO."
      },
      {
        "@language": "pt",
        "@value": "Responsável pelo Grupo de Serviços de Gestão de Dados da EMSO, encarregado da gestão de dados, da interoperabilidade e das práticas FAIR na comunidade EMSO."
      },
      {
        "@language": "fr",
        "@value": "Responsable du groupe de service pour la gestion des données d'EMSO (EMSO Data Management Service Group), en charge de la gestion des données, de l'interopérabilité et des pratiques FAIR au sein de la communauté EMSO."
      },
      {
        "@language": "ro",
        "@value": "Liderul Grupului de Servicii pentru Managementul Datelor al EMSO, responsabil pentru gestionarea datelor, interoperabilitate și practicile FAIR în cadrul comunității EMSO."
      },
      {
        "@language": "it",
        "@value": "Responsabile del Data Management Service Group di EMSO, incaricato della gestione dei dati, dell'interoperabilità e delle pratiche FAIR all'interno della comunità EMSO."
      },
      {
        "@language": "no",
        "@value": "Leder for EMSOs Data Management Service Group, med ansvar for dataforvaltning, interoperabilitet og FAIR-praksis i EMSO-fellesskapet."
      },
      {
        "@language": "en",
        "@value": "Leader of the EMSO Data Management Service Group, supporting data management, interoperability and FAIR data practices within the EMSO community."
      }
    ],
