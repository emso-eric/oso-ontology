  {
    "@id": "https://w3id.org/earthsemantics/OSO#EUXINUS",
    "@type": [
      "https://w3id.org/cerif/vocab/Project",
      "https://w3id.org/earthsemantics/OSO#FundedProject",
      "http://schema.org/Project",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "fr",
        "@value": "Le réseau EUXINUS comprend trois observatoires offshore et un observatoire côtier. La Roumanie contribue à EMSO ERIC par l’intermédiaire de GeoEcoMar en fournissant des données temps réel sur la colonne d’eau et des informations d’alerte précoce liées aux aléas marins."
      },
      {
        "@language": "en",
        "@value": "The EUXINUS network consists of three offshore observatories and one coastal observatory. Romania contributes to EMSO ERIC through GeoEcoMar by providing real-time data on water-column parameters and early-warning information related to marine hazards."
      },
      {
        "@language": "ro",
        "@value": "Rețeaua EUXINUS este formată din trei observatoare offshore și un observator de coastă. România contribuie la EMSO ERIC prin GeoEcoMar, furnizând date în timp real despre coloana de apă și informații de avertizare timpurie privind riscurile marine."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "fr",
        "@value": "Projet EUXINUS"
      },
      {
        "@language": "ro",
        "@value": "Proiectul EUXINUS"
      },
      {
        "@language": "en",
        "@value": "EUXINUS project"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.euxinus.eu/index_en.html"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "EUXINUS"
      },
      {
        "@language": "fr",
        "@value": "EUXINUS"
      },
      {
        "@language": "ro",
        "@value": "EUXINUS"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.euxinus.eu/index_en.html"
      },
      {
        "@id": "https://www.euxinus.eu/emso_euxinus_network.html"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "ro",
        "@value": "Rețeaua IOSIN EMSO-EUXINUS"
      },
      {
        "@language": "en",
        "@value": "IOSIN EMSO-EUXINUS network"
      },
      {
        "@language": "fr",
        "@value": "Réseau IOSIN EMSO-EUXINUS"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "fr",
        "@value": "Réseau régional d’observation de la mer Noire fournissant des alertes temps réel sur les aléas géologiques marins et le suivi des eaux côtières via des observatoires marins et côtiers."
      },
      {
        "@language": "ro",
        "@value": "Rețea regională de observare a Mării Negre care furnizează alerte în timp real privind riscurile geologice marine și monitorizarea apelor costiere prin observatoare marine și costiere."
      },
      {
        "@language": "en",
        "@value": "Regional Black Sea observing network providing real-time marine geohazard alerts and coastal water monitoring through marine and coastal observatories."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "fr",
        "@value": "EUXINUS"
      },
      {
