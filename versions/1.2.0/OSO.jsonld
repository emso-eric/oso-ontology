    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a bounding box to the Regional Facility it describes."
      },
      {
        "@language": "no",
        "@value": "Knytter en avgrensningsboks til den regionale infrastrukturen den beskriver."
      },
      {
        "@language": "pt",
        "@value": "Liga uma caixa delimitadora à infraestrutura regional que descreve."
      },
      {
        "@language": "fr",
        "@value": "Lie une boîte englobante à l’infrastructure régionale qu’elle décrit."
      },
      {
        "@language": "es",
        "@value": "Relaciona una caja envolvente con la infraestructura regional que describe."
      },
      {
        "@language": "ro",
        "@value": "Leagă o bounding box de infrastructura regională pe care o descrie."
      },
      {
        "@language": "el",
        "@value": "Συνδέει ένα οριοθετημένο πλαίσιο με την περιφερειακή υποδομή που περιγράφει."
      },
      {
        "@language": "it",
        "@value": "Collega un riquadro di delimitazione all'infrastruttura regionale che descrive."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/earthsemantics/OSO#BoundingBox"
      }
    ],
