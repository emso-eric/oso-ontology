  {
    "@id": "https://w3id.org/earthsemantics/OSO#ResearchInfrastructure",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://data.bioontology.org/metadata/prefixIRI": [
      {
        "@value": "OSO:ResearchInfrastructure"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "it",
        "@value": "Una infrastruttura di ricerca può riunire una o più Strutture Regionali."
      },
      {
        "@language": "pt",
        "@value": "Uma infraestrutura de investigação pode reunir uma ou mais Instalações Regionais."
      },
      {
        "@language": "ro",
        "@value": "O infrastructură de cercetare poate reuni una sau mai multe facilități regionale."
      },
      {
        "@language": "no",
        "@value": "En forskningsinfrastruktur kan samle én eller flere regionale fasiliteter."
      },
      {
        "@language": "es",
        "@value": "Una infraestructura de investigación puede reunir una o más Instalaciones Regionales."
      },
      {
        "@language": "el",
        "@value": "Μια ερευνητική υποδομή μπορεί να συγκεντρώνει μία ή περισσότερες Περιφερειακές Εγκαταστάσεις."
      },
      {
        "@language": "en",
        "@value": "A research infrastructure may bring together one or more Regional Facilities."
      },
      {
        "@language": "fr",
        "@value": "Une infrastructure de recherche peut regrouper une ou plusieurs installations régionales."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "el",
        "@value": "Ερευνητική Υποδομή"
      },
      {
        "@language": "fr",
        "@value": "Infrastructure de recherche"
      },
      {
        "@language": "es",
