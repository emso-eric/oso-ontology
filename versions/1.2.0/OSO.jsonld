    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "ro",
        "@value": "Un sit planificat, dar încă nedesfășurat sau operațional."
      },
      {
        "@language": "el",
        "@value": "Σχεδιαζόμενο: τόπος που έχει προγραμματιστεί αλλά δεν έχει ακόμη αναπτυχθεί ή λειτουργήσει."
      },
      {
        "@language": "it",
        "@value": "Un sito pianificato ma non ancora implementato né operativo."
      },
      {
        "@language": "pt",
        "@value": "Um sítio planeado mas ainda não implantado nem operacional."
      },
      {
        "@language": "es",
        "@value": "Un sitio que está planificado pero aún no desplegado ni operativo."
      },
      {
        "@language": "en",
        "@value": "A site that is planned but not yet deployed or operational."
      },
      {
        "@language": "no",
        "@value": "Et sted som er planlagt, men ennå ikke utplassert eller i drift."
      },
      {
        "@language": "fr",
        "@value": "Un site planifié mais non encore déployé ni opérationnel."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "ro",
        "@value": "Utilizat pentru a descrie situri sau infrastructuri EMSO planificate care nu sunt încă operaționale."
      },
      {
        "@language": "it",
        "@value": "Utilizzato per descrivere siti o infrastrutture EMSO pianificati ma non ancora operativi."
      },
      {
        "@language": "en",
        "@value": "Used to describe planned EMSO sites or infrastructures that are not yet operational."
      },
      {
        "@language": "es",
        "@value": "Utilizado para describir sitios o infraestructuras EMSO planificados que aún no están operativos."
      },
      {
        "@language": "no",
        "@value": "Brukes til å beskrive planlagte EMSO-steder eller infrastrukturer som ennå ikke er i drift."
      },
      {
        "@language": "el",
        "@value": "Χρησιμοποιείται για την περιγραφή σχεδιαζόμενων τοποθεσιών ή υποδομών EMSO που δεν είναι ακόμη λειτουργικές."
      },
      {
        "@language": "pt",
        "@value": "Utilizado para descrever sítios ou infraestruturas EMSO planeadas que ainda não estão operacionais."
