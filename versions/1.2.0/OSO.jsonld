    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un sistema de gestión de bases de datos híbrido de código abierto que proporciona un almacén de tripletas RDF, un endpoint SPARQL, una base de datos SQL y un servidor Linked Data."
      },
      {
        "@language": "pt",
        "@value": "Um sistema híbrido de gestão de bases de dados open source que fornece um repositório RDF, um endpoint SPARQL, uma base de dados SQL e um servidor Linked Data."
      },
      {
        "@language": "en",
        "@value": "An open-source hybrid database management system providing RDF triple store, SPARQL endpoint, SQL database and Linked Data server capabilities."
      },
      {
        "@language": "fr",
        "@value": "Un système de gestion de base de données hybride open source offrant un magasin de triplets RDF, un endpoint SPARQL, une base SQL et un serveur Linked Data."
      },
      {
        "@language": "it",
        "@value": "Un sistema di gestione di basi di dati ibrido open source che fornisce un archivio RDF, un endpoint SPARQL, un database SQL e un server Linked Data."
      },
      {
        "@language": "ro",
        "@value": "Un sistem open-source hibrid de gestionare a bazelor de date care oferă un depozit RDF, un endpoint SPARQL, o bază de date SQL și un server Linked Data."
      },
      {
