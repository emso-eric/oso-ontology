    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Long-term open ocean observatory site operated by PLOCAN north of Gran Canaria as part of EMSO Canarias, supporting multidisciplinary ocean monitoring, glider missions and climate observations in the North Atlantic Ocean."
      },
      {
        "@language": "fr",
        "@value": "Site d’observation océanique de long terme exploité par PLOCAN au nord de Grande Canarie dans le cadre d’EMSO Canarias, supportant des observations multidisciplinaires de l’océan, des missions de gliders et des études climatiques dans l’océan Atlantique Nord."
      },
      {
        "@language": "es",
        "@value": "Sitio de observación oceánica de largo plazo operado por PLOCAN al norte de Gran Canaria como parte de EMSO Canarias, apoyando la monitorización multidisciplinar del océano, misiones de gliders y observaciones climáticas en el Atlántico Norte."
      }
