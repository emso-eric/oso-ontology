  {
    "@id": "https://w3id.org/earthsemantics/OSO#isERICMembershipOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "el",
        "@value": "Συνδέει μια οντότητα συμμετοχής ERIC με την αντίστοιχη περιφερειακή υποδομή."
      },
      {
        "@language": "ro",
        "@value": "Leagă o entitate de apartenență ERIC de infrastructura regională corespunzătoare."
      },
      {
        "@language": "en",
        "@value": "Links an ERIC membership entity to the regional facility concerned."
      },
      {
        "@language": "pt",
        "@value": "Liga uma entidade de adesão ERIC à infraestrutura regional correspondente."
      },
      {
        "@language": "no",
        "@value": "Knytter en ERIC-medlemskapsenhet til den aktuelle regionale infrastrukturen."
      },
      {
        "@language": "it",
        "@value": "Collega un'entità di adesione ERIC alla infrastruttura regionale corrispondente."
      },
      {
        "@language": "es",
        "@value": "Relaciona una entidad de membresía ERIC con la infraestructura regional correspondiente."
      },
      {
        "@language": "fr",
        "@value": "Lie une entité d’adhésion ERIC à la regional facility concernée."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/earthsemantics/OSO#ERICMembership"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "el",
        "@value": "είναι συμμετοχή σε ERIC του"
      },
      {
        "@language": "it",
        "@value": "è appartenenza a un ERIC di"
      },
      {
        "@language": "en",
        "@value": "is ERIC membership of"
      },
      {
        "@language": "no",
        "@value": "er medlemskap i et ERIC for"
      },
      {
        "@language": "ro",
        "@value": "este apartenență la un ERIC a"
      },
      {
        "@language": "fr",
        "@value": "est une appartenance à un ERIC de"
      },
      {
        "@language": "es",
        "@value": "es membresía en un ERIC de"
      },
      {
        "@language": "pt",
        "@value": "é participação em um ERIC de"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/earthsemantics/OSO#RegionalFacility"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://w3id.org/earthsemantics/OSO#hasERICMembership"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "no",
        "@value": "Knytter en ERIC-medlemskapsenhet til den regionale infrastrukturen som deltar i eller drar nytte av medlemskapet."
      },
      {
        "@language": "it",
        "@value": "Collega un'entità di adesione ERIC alla infrastruttura regionale che partecipa o beneficia di tale adesione."
      },
      {
        "@language": "es",
        "@value": "Relaciona una entidad de membresía ERIC con la infraestructura regional que participa o se beneficia de dicha membresía."
      },
      {
        "@language": "el",
        "@value": "Συνδέει μια οντότητα συμμετοχής ERIC με την περιφερειακή υποδομή που συμμετέχει ή επωφελείται από αυτήν τη συμμετοχή."
      },
      {
        "@language": "pt",
        "@value": "Liga uma entidade de adesão ERIC à infraestrutura regional que participa ou beneficia dessa adesão."
      },
      {
        "@language": "ro",
        "@value": "Leagă o entitate de apartenență ERIC de infrastructura regională care participă sau beneficiază de această apartenență."
      },
      {
        "@language": "en",
        "@value": "Relates an ERIC membership entity to the regional facility benefiting from or participating in the ERIC membership."
      },
      {
        "@language": "fr",
        "@value": "Relie une entité d’adhésion ERIC à la regional facility bénéficiant ou participant à cette adhésion."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "el",
        "@value": "είναι συμμετοχή σε ERIC του"
      },
      {
        "@language": "en",
        "@value": "is ERIC membership of"
      },
      {
        "@language": "it",
        "@value": "è appartenenza a un ERIC di"
      },
