        "@value": "ΕΥ"
      },
      {
        "@language": "it",
        "@value": "IR"
      },
      {
        "@language": "en",
        "@value": "RI"
      },
      {
        "@language": "no",
        "@value": "FI"
      },
      {
        "@language": "pt",
        "@value": "II"
