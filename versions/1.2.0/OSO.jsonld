        "@value": "Quelles campagnes océanographiques sont associées à une infrastructure régionale ?"
      },
      {
        "@language": "no",
        "@value": "Hva er dybden til en plattform?"
      },
      {
        "@language": "pt",
        "@value": "Qual é a profundidade de uma plataforma?"
      },
      {
        "@language": "en",
        "@value": "Who is the Principal Investigator or Regional Team Leader?"
      },
      {
        "@language": "es",
