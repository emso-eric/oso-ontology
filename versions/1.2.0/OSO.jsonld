    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An EMSO observation site located in the central Fram Strait between Greenland and Svalbard, dedicated to long-term monitoring of Arctic Ocean processes and climate variability."
      },
      {
        "@language": "fr",
        "@value": "Un site d’observation EMSO situé dans le détroit central de Fram entre le Groenland et le Svalbard, dédié au suivi à long terme des processus océaniques arctiques et de la variabilité climatique."
      },
      {
        "@language": "no",
        "@value": "Et EMSO-observasjonssted lokalisert i det sentrale Framstredet mellom Grønland og Svalbard, dedikert til langsiktig overvåking av arktiske havprosesser og klimavariabilitet."
      }
    ],
