  {
    "@id": "https://w3id.org/earthsemantics/OSO#Ifremer",
    "@type": [
      "https://w3id.org/cerif/vocab/Organisation",
      "http://xmlns.com/foaf/0.1/Organization",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "fr",
        "@value": "Ifremer est l’institut français de recherche pour l’exploitation de la mer. Il conduit des recherches, apporte de l’expertise et partage des données marines afin d’améliorer la connaissance de l’océan, de protéger les milieux marins et d’accompagner la gestion durable des ressources et des écosystèmes marins."
      },
      {
        "@language": "en",
        "@value": "Ifremer is the French national institute for ocean science and technology. It conducts research, provides expertise and shares marine data to improve knowledge of the ocean, protect marine environments, and support the sustainable management of marine resources and ecosystems."
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://ror.org/044jxhp58"
