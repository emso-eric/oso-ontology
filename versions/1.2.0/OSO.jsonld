    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates a research infrastructure to the person responsible for leading it."
      },
      {
        "@language": "ro",
        "@value": "Leagă o infrastructură de cercetare de persoana responsabilă de conducerea acesteia."
      },
      {
        "@language": "no",
        "@value": "Knytter en forskningsinfrastruktur til personen som leder den."
      },
      {
        "@language": "it",
        "@value": "Collega un'infrastruttura di ricerca alla persona responsabile della sua direzione."
      },
      {
        "@language": "pt",
        "@value": "Liga uma infraestrutura de investigação à pessoa responsável pela sua liderança."
      },
      {
        "@language": "el",
        "@value": "Συνδέει μια ερευνητική υποδομή με το πρόσωπο που είναι υπεύθυνο για τη διεύθυνσή της."
