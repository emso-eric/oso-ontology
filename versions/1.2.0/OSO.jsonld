    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An EMSO-EUXINUS observatory site in the western Black Sea, composed of a surface buoy acoustically linked to a seabed system and connected to the shore by satellite."
      },
      {
        "@language": "fr",
        "@value": "Un site d’observation EMSO-EUXINUS en mer Noire occidentale, composé d’une bouée de surface reliée acoustiquement à un système fond de mer et connectée à la côte par satellite."
      },
      {
        "@language": "ro",
        "@value": "Un sit de observare EMSO-EUXINUS în vestul Mării Negre, compus dintr-o geamandură de suprafață conectată acustic la un sistem de fund marin și legată de țărm prin satelit."
      }
    ],
