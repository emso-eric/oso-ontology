    "http://purl.org/dc/terms/description": [
      {
        "@language": "ca",
        "@value": "OBSEA és un observatori submarí cablejat situat a 4 km de la costa de Vilanova i la Geltrú dins d’una àrea protegida de pesca. Està connectat a terra mitjançant un cable mixt d’energia i comunicacions (OceanOPS WMO número: 6103565)."
      },
      {
        "@language": "en",
        "@value": "OBSEA is a cabled seafloor observatory located 4 km off the Vilanova i la Geltrú coast in a fishing protected area. It is connected to the coast by an energy and communications mixed cable (OceanOPS WMO number: 6103565)."
      }
    ],
