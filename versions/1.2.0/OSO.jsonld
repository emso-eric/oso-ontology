    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Antiguo Director General de EMSO ERIC y geofísico marino implicado en infraestructuras europeas de investigación marina."
      },
      {
        "@language": "el",
        "@value": "Πρώην Γενικός Διευθυντής του EMSO ERIC και θαλάσσιος γεωφυσικός που συμμετέχει σε ευρωπαϊκές θαλάσσιες ερευνητικές υποδομές."
      },
      {
        "@language": "ro",
        "@value": "Fost director general al EMSO ERIC și geofizician marin implicat în infrastructurile europene de cercetare marină."
      },
      {
        "@language": "fr",
        "@value": "Ancien directeur général d’EMSO ERIC et géophysicien marin impliqué dans les infrastructures européennes de recherche marine."
      },
      {
        "@language": "it",
        "@value": "Ex direttore generale di EMSO ERIC e geofisico marino coinvolto nelle infrastrutture europee di ricerca marina."
      },
      {
        "@language": "no",
        "@value": "Tidligere generaldirektør for EMSO ERIC og marin geofysiker involvert i europeiske marine forskningsinfrastrukturer."
      },
      {
        "@language": "en",
        "@value": "Former Director General of EMSO ERIC and marine geophysicist involved in European marine research infrastructures."
      },
      {
        "@language": "pt",
        "@value": "Antigo Diretor-Geral do EMSO ERIC e geofísico marinho envolvido em infraestruturas europeias de investigação marinha."
      }
    ],
