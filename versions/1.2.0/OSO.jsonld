  {
    "@id": "https://w3id.org/earthsemantics/OSO#isManagedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ro",
        "@value": "Leagă o infrastructură de cercetare (ERIC sau națională) de organizația care o gestionează sau coordonează."
      },
      {
        "@language": "no",
        "@value": "Knytter en forskningsinfrastruktur (ERIC eller nasjonal) til organisasjonen som administrerer eller koordinerer den."
      },
      {
        "@language": "es",
        "@value": "Relaciona una infraestructura de investigación (ERIC o nacional) con la organización que la gestiona o coordina."
      },
      {
        "@language": "en",
        "@value": "Links a research infrastructure (ERIC or national) to the organisation that manages or coordinates it."
      },
      {
        "@language": "el",
        "@value": "Συνδέει μια ερευνητική υποδομή (ERIC ή εθνική) με τον οργανισμό που τη διαχειρίζεται ή τη συντονίζει."
      },
      {
        "@language": "fr",
        "@value": "Lie une infrastructure de recherche (ERIC ou nationale) à l’organisation qui la gère ou la coordonne."
      },
      {
        "@language": "pt",
        "@value": "Liga uma infraestrutura de investigação (ERIC ou nacional) à organização que a gere ou coordena."
      },
      {
        "@language": "it",
        "@value": "Collega un'infrastruttura di ricerca (ERIC o nazionale) all'organizzazione che la gestisce o coordina."
      }
    ],
