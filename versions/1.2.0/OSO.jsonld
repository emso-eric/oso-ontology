      },
      {
        "@language": "it",
        "@value": "Mar Nero"
      },
      {
        "@language": "ro",
        "@value": "Marea Neagră"
      },
      {
        "@language": "el",
        "@value": "Μαύρη Θάλασσα"
      },
      {
        "@language": "fr",
        "@value": "Mer Noire"
      }
    ],
