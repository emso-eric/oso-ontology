  {
    "@id": "https://w3id.org/earthsemantics/OSO#leadsSite",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ro",
        "@value": "Leagă o organizație de un sit pe care îl coordonează."
      },
      {
        "@language": "el",
        "@value": "Συνδέει έναν οργανισμό με μια τοποθεσία που συντονίζει."
      },
      {
        "@language": "pt",
        "@value": "Liga uma organização a um local que coordena."
      },
      {
        "@language": "fr",
        "@value": "Lie une organisation à un site qu’elle pilote."
      },
      {
        "@language": "no",
        "@value": "Knytter en organisasjon til et sted den leder."
      },
      {
        "@language": "en",
        "@value": "Links an organisation to a site it leads."
      },
      {
        "@language": "it",
        "@value": "Collega un'organizzazione a un sito che coordina."
