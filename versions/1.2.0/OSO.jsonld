    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "pt",
        "@value": "Plataforma de observação dos fundos marinhos profundos dedicada ao acompanhamento de habitats de corais de águas frias no canyon de Lampaul, ao largo da Bretanha."
      },
      {
        "@language": "fr",
        "@value": "Plateforme d’observation des grands fonds dédiée au suivi des habitats de coraux d’eau froide dans le canyon de Lampaul au large de la Bretagne."
      },
      {
        "@language": "en",
        "@value": "Deep seafloor observing platform dedicated to the monitoring of cold-water coral habitats in the Lampaul Canyon off Brittany, France."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "fr",
        "@value": "L’observatoire MARLEY est déployé depuis 2021 afin de suivre les écosystèmes de coraux d’eau froide à 780 m de profondeur dans le canyon de Lampaul."
      },
      {
        "@language": "en",
        "@value": "The MARLEY observatory has been deployed since 2021 to monitor cold-water coral ecosystems at 780 m depth in the Lampaul Canyon."
      }
    ],
