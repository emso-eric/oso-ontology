  {
    "@id": "https://w3id.org/earthsemantics/OSO#eastBoundLongitude",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "no",
        "@value": "Østligste lengdegrad i en geografisk avgrensningsboks, tilsvarende eastBoundLongitude i ISO 19115-3."
      },
      {
        "@language": "el",
        "@value": "Η ανατολικότερη γεωγραφική longitude ενός γεωγραφικού πλαισίου, που αντιστοιχεί στο eastBoundLongitude του ISO 19115-3."
      },
      {
        "@language": "en",
        "@value": "Easternmost longitude of a geographic bounding box, corresponding to eastBoundLongitude in ISO 19115-3."
      },
      {
        "@language": "ro",
        "@value": "Longitudinea estică maximă a unei zone geografice delimitate, corespunzătoare eastBoundLongitude din ISO 19115-3."
      },
      {
        "@language": "es",
        "@value": "Longitud oriental máxima de una caja geográfica delimitadora, correspondiente a eastBoundLongitude en ISO 19115-3."
