  {
    "@id": "https://w3id.org/earthsemantics/OSO#RegionalFacility_is_part_of_a_RI",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ro",
        "@value": "Leagă o infrastructură regională de infrastructura sa principală de cercetare."
      },
      {
        "@language": "es",
        "@value": "Relaciona una infraestructura regional con su infraestructura de investigación principal."
      },
      {
        "@language": "en",
        "@value": "Links a regional facility to its parent research infrastructure."
      },
      {
        "@language": "it",
        "@value": "Collega un'infrastruttura regionale alla sua infrastruttura di ricerca principale."
      },
      {
        "@language": "el",
        "@value": "Συνδέει μια περιφερειακή υποδομή με τη μητρική της ερευνητική υποδομή."
      },
      {
        "@language": "pt",
        "@value": "Liga uma infraestrutura regional à sua infraestrutura de investigação principal."
