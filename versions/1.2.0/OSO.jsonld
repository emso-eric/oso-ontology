      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "fr",
        "@value": "Le Marine Institute est l’organisme national chargé de la recherche marine, du développement technologique et de l’innovation."
      },
      {
        "@language": "en",
        "@value": "The Marine Institute is the national agency responsible for marine research, technology development and innovation."
      },
      {
        "@language": "ga",
        "@value": "Is é an Marine Institute an ghníomhaireacht náisiúnta atá freagrach as taighde mara, forbairt teicneolaíochta agus nuálaíocht."
      }
    ],
