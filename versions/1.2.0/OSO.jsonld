  {
    "@id": "https://w3id.org/earthsemantics/OSO#MARLEY",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/earthsemantics/OSO#Platform"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "fr",
        "@value": "MARLEY (Monitoring deep-seA coRaL EcosYstems) est un système d’observation des grands fonds dédié au suivi des habitats de coraux d’eau froide. Le système est déployé dans le canyon de Lampaul au large de la Bretagne depuis août 2021 et est maintenu chaque année lors des campagnes ChEReef-Obs. Le site étudié correspond à un jardin de coraux dominé par Madrepora oculata situé sur une plateforme sédimentaire à 780 m de profondeur."
      },
      {
        "@language": "en",
        "@value": "MARLEY (Monitoring deep-seA coRaL EcosYstems) is a deep seafloor observing system dedicated to the monitoring of cold-water coral habitats. The system has been deployed in the Lampaul Canyon off Brittany, France since August 2021 and is maintained annually during the ChEReef-Obs cruises. The study site is a coral garden dominated by Madrepora oculata located on a sedimented platform at 780 m depth."
      }
    ],
    "http://purl.org/dc/terms/isReferencedBy": [
      {
        "@id": "https://doi.org/10.17882/111225"
      }
    ],
    "http://purl.org/dc/terms/spatial": [
      {
        "@id": "http://dbpedia.org/resource/Brittany"
      },
      {
        "@id": "http://dbpedia.org/resource/Bay_of_Biscay"
      },
      {
