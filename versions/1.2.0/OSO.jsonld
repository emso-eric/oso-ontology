    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "pt",
        "@value": "Infraestrutura regional EMSO-PT da Margem Ibérica"
      },
      {
        "@language": "fr",
        "@value": "Infrastructure régionale EMSO-PT de la marge ibérique"
      },
      {
        "@language": "en",
        "@value": "EMSO-PT Iberian Margin Regional Facility"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "fr",
        "@value": "Infrastructure régionale EMSO située sur la marge ibérique et exploitée dans le cadre d’EMSO-PT pour des activités multidisciplinaires d’observation océanique et de surveillance des aléas géologiques."
      },
      {
        "@language": "pt",
        "@value": "Infraestrutura regional do EMSO localizada na Margem Ibérica e operada no âmbito do EMSO-PT para atividades multidisciplinares de observação oceânica e monitorização de riscos geológicos."
      },
      {
        "@language": "en",
        "@value": "EMSO Regional Facility located on the Iberian Margin and operated within EMSO-PT for multidisciplinary ocean observation and geo-hazard monitoring activities."
      }
    ],
