      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "it",
        "@value": "Infrastruttura regionale EMSO associata al Mar Ligure e dedicata all’osservazione marina multidisciplinare a lungo termine nel Mediterraneo occidentale."
      },
      {
        "@language": "fr",
        "@value": "Infrastructure régionale EMSO associée à la mer Ligure et dédiée à l’observation marine multidisciplinaire à long terme en Méditerranée occidentale."
      },
      {
        "@language": "en",
        "@value": "Regional EMSO facility associated with the Ligurian Sea and dedicated to long-term multidisciplinary marine observation in the western Mediterranean Sea."
      }
    ],
