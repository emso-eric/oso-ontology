    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Una plataforma web utilizada para alojar código fuente, gestionar versiones, realizar el seguimiento de incidencias y desarrollar colaborativamente la ontología OSO."
      },
      {
        "@language": "fr",
        "@value": "Une plateforme web utilisée pour l’hébergement du code source, le contrôle de version, le suivi des tickets et le développement collaboratif de l’ontologie OSO."
      },
      {
        "@language": "it",
        "@value": "Una piattaforma web utilizzata per l’hosting del codice sorgente, il controllo di versione, il tracciamento delle issue e lo sviluppo collaborativo dell’ontologia OSO."
      },
      {
        "@language": "en",
        "@value": "A web-based platform used for source code hosting, version control, issue tracking and collaborative development of the OSO ontology."
      },
      {
        "@language": "el",
        "@value": "Μια διαδικτυακή πλατφόρμα που χρησιμοποιείται για φιλοξενία πηγαίου κώδικα, έλεγχο εκδόσεων, παρακολούθηση ζητημάτων και συνεργατική ανάπτυξη της οντολογίας OSO."
      },
      {
        "@language": "no",
        "@value": "En nettbasert plattform brukt til kildekodehosting, versjonskontroll, saksoppfølging og samarbeidsbasert utvikling av OSO-ontologien."
      },
      {
        "@language": "pt",
        "@value": "Uma plataforma web utilizada para alojamento de código-fonte, controlo de versões, acompanhamento de problemas e desenvolvimento colaborativo da ontologia OSO."
      },
      {
        "@language": "ro",
        "@value": "O platformă web utilizată pentru găzduirea codului sursă, controlul versiunilor, urmărirea problemelor și dezvoltarea colaborativă a ontologiei OSO."
      }
    ],
