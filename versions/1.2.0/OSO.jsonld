    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "el",
        "@value": "Μια εταιρεία λογισμικού που αναπτύσσει τεχνολογίες ολοκλήρωσης δεδομένων, Σημασιολογικού Ιστού και πολυμοντελικών βάσεων δεδομένων, συμπεριλαμβανομένου του Virtuoso Universal Server."
      },
      {
        "@language": "pt",
        "@value": "Uma empresa de software que desenvolve tecnologias de integração de dados, Web Semântica e bases de dados multimodelo, incluindo o Virtuoso Universal Server."
      },
      {
        "@language": "no",
        "@value": "Et programvareselskap som utvikler teknologier for dataintegrasjon, semantisk web og multimodell-databaser, inkludert Virtuoso Universal Server."
      },
      {
        "@language": "it",
        "@value": "Una società di software che sviluppa tecnologie per l'integrazione dei dati, il Web semantico e basi di dati multi-modello, tra cui Virtuoso Universal Server."
      },
      {
        "@language": "en",
        "@value": "A software company developing data integration, semantic web and multi-model database technologies, including Virtuoso Universal Server."
      },
      {
        "@language": "es",
        "@value": "Una empresa de software que desarrolla tecnologías de integración de datos, web semántica y bases de datos multimodelo, incluido Virtuoso Universal Server."
      },
      {
        "@language": "fr",
        "@value": "Une société éditrice de logiciels développant des technologies d'intégration de données, de Web sémantique et de bases de données multi-modèles, notamment Virtuoso Universal Server."
      },
      {
        "@language": "ro",
        "@value": "O companie software care dezvoltă tehnologii pentru integrarea datelor, Web-ul Semantic și baze de date multi-model, inclusiv Virtuoso Universal Server."
      }
