    "https://w3id.org/mod#competencyQuestion": [
      {
        "@language": "es",
        "@value": "¿Qué sitios forman parte de una infraestructura regional?"
      },
      {
        "@language": "el",
        "@value": "Ποιος είναι ο κύριος ερευνητής (PI) ή ο περιφερειακός υπεύθυνος;"
      },
      {
        "@language": "pt",
        "@value": "Quais organizações estão envolvidas numa determinada infraestrutura de observação?"
      },
      {
        "@language": "ro",
        "@value": "Cine este Investigatorul Principal (PI) sau responsabilul regional?"
      },
      {
        "@language": "no",
        "@value": "Hvilke organisasjoner er involvert i en gitt observasjonsinfrastruktur?"
      },
      {
        "@language": "es",
        "@value": "¿Qué campañas oceanográficas están asociadas a una infraestructura regional?"
      },
      {
        "@language": "it",
        "@value": "Qual è la profondità di una piattaforma?"
      },
      {
        "@language": "en",
        "@value": "Which oceanographic cruises are associated with a regional facility?"
      },
      {
        "@language": "es",
        "@value": "¿Qué plataformas pertenecen a un sitio dado?"
      },
      {
        "@language": "el",
        "@value": "Ποιες πλατφόρμες ανήκουν σε έναν συγκεκριμένο σταθμό;"
      },
      {
        "@language": "ro",
        "@value": "Ce campanii oceanografice sunt asociate unei infrastructuri regionale?"
      },
      {
        "@language": "fr",
        "@value": "Qui est le responsable scientifique (PI) ou le responsable régional ?"
      },
      {
        "@language": "fr",
        "@value": "Quels sites font partie d’une infrastructure régionale ?"
      },
      {
        "@language": "en",
        "@value": "Which platforms belong to a given site?"
      },
      {
        "@language": "no",
        "@value": "Hvem er hovedansvarlig forsker (PI) eller regional leder?"
      },
      {
        "@language": "no",
        "@value": "Hvilke oseanografiske tokt er knyttet til en regional infrastruktur?"
      },
      {
        "@language": "el",
        "@value": "Ποιοι σταθμοί αποτελούν μέρος μιας περιφερειακής υποδομής;"
      },
      {
        "@language": "en",
        "@value": "Which organisations are involved in a given observatory infrastructure?"
      },
      {
        "@language": "pt",
        "@value": "Quais campanhas oceanográficas estão associadas a uma infraestrutura regional?"
      },
      {
        "@language": "ro",
        "@value": "Ce situri fac parte dintr-o infrastructură regională?"
      },
