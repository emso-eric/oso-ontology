    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "E1M3A marine observatory"
      },
      {
        "@language": "el",
        "@value": "Παρατηρητήριο E1M3A"
      },
      {
