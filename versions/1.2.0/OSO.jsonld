  {
    "@id": "https://w3id.org/earthsemantics/OSO#BoundingBox",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "pt",
        "@value": "Representa uma área geográfica retangular definida por limites de coordenadas norte, sul, este e oeste. Este conceito está alinhado com a ISO 19115-3 e interoperável com geometrias GeoSPARQL."
      },
      {
        "@language": "es",
        "@value": "Representa un área geográfica rectangular definida por límites de coordenadas norte, sur, este y oeste. Este concepto está alineado con ISO 19115-3 e interoperable con las geometrías GeoSPARQL."
      },
      {
        "@language": "el",
        "@value": "Αναπαριστά μια ορθογώνια γεωγραφική περιοχή που ορίζεται από βόρεια, νότια, ανατολικά και δυτικά όρια συντεταγμένων. Η έννοια αυτή είναι ευθυγραμμισμένη με το ISO 19115-3 και διαλειτουργική με τις γεωμετρίες GeoSPARQL."
      },
      {
        "@language": "fr",
        "@value": "Représente une zone géographique rectangulaire définie par des limites de coordonnées nord, sud, est et ouest. Ce concept est aligné sur l’ISO 19115-3 et interopérable avec les géométries GeoSPARQL."
      },
      {
        "@language": "no",
        "@value": "Representerer et rektangulært geografisk område definert av nordlige, sørlige, østlige og vestlige koordinatgrenser. Dette konseptet er tilpasset ISO 19115-3 og interoperabelt med GeoSPARQL-geometrier."
      },
      {
        "@language": "en",
        "@value": "Represents a rectangular geographic area defined by northern, southern, eastern and western coordinate boundaries. This concept is aligned with ISO 19115-3 and interoperable with GeoSPARQL geometries."
      },
      {
        "@language": "ro",
        "@value": "Reprezintă o zonă geografică dreptunghiulară definită prin limite de coordonate nordice, sudice, estice și vestice. Acest concept este aliniat cu ISO 19115-3 și interoperabil cu geometriile GeoSPARQL."
      },
      {
        "@language": "it",
        "@value": "Rappresenta un'area geografica rettangolare definita da limiti di coordinate nord, sud, est e ovest. Questo concetto è allineato con ISO 19115-3 ed è interoperabile con le geometrie GeoSPARQL."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Bounding Box"
      },
      {
        "@language": "es",
        "@value": "Caja delimitadora"
      },
      {
        "@language": "ro",
        "@value": "Cadru delimitator"
      },
      {
        "@language": "el",
        "@value": "Γεωγραφικό πλαίσιο"
      },
      {
        "@language": "fr",
        "@value": "Boîte englobante"
      },
      {
        "@language": "no",
        "@value": "Avgrensningsboks"
      },
      {
        "@language": "pt",
        "@value": "Caixa delimitadora"
      },
      {
        "@language": "it",
        "@value": "Riquadro geografico"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.opengis.net/ont/geosparql#Geometry"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "pt",
        "@value": "Uma caixa geográfica delimitadora que define a extensão espacial de um local de observação marinha, infraestrutura regional, plataforma ou recurso relacionado."
      },
      {
        "@language": "it",
        "@value": "Un riquadro geografico che definisce l'estensione spaziale di un sito di osservazione marina, infrastruttura regionale, piattaforma o risorsa correlata."
      },
      {
        "@language": "el",
        "@value": "Ένα γεωγραφικό πλαίσιο που ορίζει τη χωρική έκταση μιας θαλάσσιας τοποθεσίας παρατήρησης, περιφερειακής υποδομής, πλατφόρμας ή σχετικού πόρου."
      },
      {
        "@language": "es",
        "@value": "Una caja geográfica delimitadora que define la extensión espacial de un sitio de observación marina, infraestructura regional, plataforma o recurso relacionado."
      },
      {
        "@language": "fr",
        "@value": "Une boîte englobante géographique définissant l’emprise spatiale d’un site d’observation marine, d’une infrastructure régionale, d’une plateforme ou d’une ressource associée."
      },
      {
        "@language": "no",
        "@value": "En geografisk avgrensningsboks som definerer den romlige utstrekningen til et marint observasjonssted, regional infrastruktur, plattform eller relatert ressurs."
      },
      {
        "@language": "en",
        "@value": "A geographic bounding box defining the spatial extent of a marine observation site, regional facility, platform or related resource."
      },
      {
        "@language": "ro",
        "@value": "O zonă geografică delimitată care definește extinderea spațială a unui sit de observație marină, infrastructuri regionale, platforme sau resurse asociate."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "ro",
        "@value": "Cadru delimitator"
      },
      {
        "@language": "el",
        "@value": "Γεωγραφικό πλαίσιο"
      },
      {
        "@language": "fr",
        "@value": "Boîte englobante"
      },
      {
        "@language": "no",
        "@value": "Avgrensningsboks"
      },
      {
        "@language": "it",
        "@value": "Riquadro geografico"
      },
      {
        "@language": "en",
        "@value": "Bounding Box"
      },
      {
        "@language": "es",
        "@value": "Caja delimitadora"
      },
      {
        "@language": "pt",
        "@value": "Caixa delimitadora"
      }
    ]
  },
