@prefix OSO: <https://w3id.org/earthsemantics/OSO#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# OSO SHACL validation profile
#
# SHACL profile version: 1.2.0
# Target OSO ontology version: 1.2.0
# =============================================================================

<https://w3id.org/earthsemantics/OSO/shacl>
    a owl:Ontology ;

    dcterms:title
        "Προφίλ επικύρωσης SHACL του OSO"@el,
        "OSO SHACL validation profile"@en,
        "Perfil de validación SHACL de OSO"@es,
        "Profil de validation SHACL d’OSO"@fr,
        "Profilo di validazione SHACL di OSO"@it,
        "OSO SHACL-valideringsprofil"@no,
        "Perfil de validação SHACL do OSO"@pt,
        "Profil de validare SHACL pentru OSO"@ro ;

    dcterms:description
        "Προφίλ επικύρωσης SHACL για δεδομένα RDF που συμμορφώνονται με την έκδοση 1.2.0 της οντολογίας Observatories of the Seas Ontology (OSO)."@el,
        "SHACL validation profile for RDF data conforming to version 1.2.0 of the Observatories of the Seas Ontology (OSO)."@en,
        "Perfil de validación SHACL para datos RDF conformes con la versión 1.2.0 de la ontología Observatories of the Seas Ontology (OSO)."@es,
        "Profil de validation SHACL pour les données RDF conformes à la version 1.2.0 de l’ontologie Observatories of the Seas Ontology (OSO)."@fr,
        "Profilo di validazione SHACL per dati RDF conformi alla versione 1.2.0 dell’ontologia Observatories of the Seas Ontology (OSO)."@it,
        "SHACL-valideringsprofil for RDF-data som er i samsvar med versjon 1.2.0 av ontologien Observatories of the Seas Ontology (OSO)."@no,
        "Perfil de validação SHACL para dados RDF em conformidade com a versão 1.2.0 da ontologia Observatories of the Seas Ontology (OSO)."@pt,
        "Profil de validare SHACL pentru date RDF conforme cu versiunea 1.2.0 a ontologiei Observatories of the Seas Ontology (OSO)."@ro ;

    dcterms:creator OSO:Ifremer ;

    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;

    dcterms:conformsTo <http://www.w3.org/ns/shacl#> ;

    dcterms:relation <https://w3id.org/earthsemantics/OSO/1.2.0/> ;

    dcterms:source <https://w3id.org/earthsemantics/OSO/1.2.0/> ;

    dcterms:issued "2026-08-24"^^xsd:date ;

    rdfs:seeAlso
        <https://w3id.org/earthsemantics/OSO>,
        <https://github.com/emso-eric/oso-ontology>,
        <https://emso-eric.github.io/oso-ontology/> ;

    owl:versionIRI <https://w3id.org/earthsemantics/OSO/shacl/1.2.0/> ;
    owl:versionInfo "1.2.0" .

# =============================================================================
# BoundingBoxShape
# Validates geographic bounding boxes.
#
# Checks:
# - longitude values are xsd:decimal and within [-180, 180]
# - latitude values are xsd:decimal and within [-90, 90]
# - each geographic boundary occurs at most once
# =============================================================================
OSO:BoundingBoxShape
    a sh:NodeShape ;
    sh:targetClass OSO:BoundingBox ;

sh:property [
        sh:path OSO:westBoundLongitude ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -180 ;
        sh:maxInclusive 180 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
] ;

sh:property [
        sh:path OSO:eastBoundLongitude ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -180 ;
        sh:maxInclusive 180 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
] ;

sh:property [
        sh:path OSO:southBoundLatitude ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -90 ;
        sh:maxInclusive 90 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
] ;
    
sh:property [
        sh:path OSO:northBoundLatitude ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -90 ;
        sh:maxInclusive 90 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
] .

# =============================================================================
# SiteShape
# Validates OSO observation sites.
#
# Checks:
# - containsPlatform values are IRIs
# - containsPlatform values are instances of OSO:Platform
#
# Note:
# - the presence of containsPlatform is not mandatory in this SHACL profile
# - no maximum number of platforms is imposed
# =============================================================================

OSO:SiteShape
    a sh:NodeShape ;
    sh:targetClass OSO:Site ;

    sh:property [
        sh:path OSO:containsPlatform ;
        sh:class OSO:Platform ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# PlatformShape
# Validates OSO observation platforms.
#
# Checks:
# - hasPlatformCategory values are IRIs
#
# Note:
# - the presence of hasPlatformCategory is not mandatory in this SHACL profile
# - the external NERC L06 concepts are not required to be locally typed
# =============================================================================

OSO:PlatformShape
    a sh:NodeShape ;
    sh:targetClass OSO:Platform ;

    sh:property [
        sh:path OSO:hasPlatformCategory ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# RegionalFacilityShape
# Validates OSO regional facilities.
#
# Checks:
# - containsSite values are IRIs
# - containsSite values are instances of OSO:Site
#
# Note:
# - the presence of containsSite is not mandatory in this SHACL profile
# - no maximum number of sites is imposed
# =============================================================================

OSO:RegionalFacilityShape
    a sh:NodeShape ;
    sh:targetClass OSO:RegionalFacility ;

    sh:property [
        sh:path OSO:containsSite ;
        sh:class OSO:Site ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# ERICMembershipShape
# Validates ERIC membership entities.
#
# Checks:
# - membershipInERIC values are IRIs
# - membershipInERIC values are instances of OSO:ERIC
# - isERICMembershipOf values are IRIs
# - isERICMembershipOf values are instances of OSO:RegionalFacility
#
# Note:
# - the presence of these properties is not mandatory in this SHACL profile
# - no cardinality constraints are imposed at this stage
# =============================================================================

OSO:ERICMembershipShape
    a sh:NodeShape ;
    sh:targetClass OSO:ERICMembership ;

    sh:property [
        sh:path OSO:membershipInERIC ;
        sh:class OSO:ERIC ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path OSO:isERICMembershipOf ;
        sh:class OSO:RegionalFacility ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# DeploymentDateShape
# Validates OSO deployment dates.
#
# Checks:
# - dateFirstDeployment values use xsd:date, xsd:gYearMonth or xsd:gYear
# - dateEndDeployment values use xsd:date, xsd:gYearMonth or xsd:gYear
#
# Note:
# - deployment dates are optional
# - partial dates are allowed when only the year or year-month is known
# =============================================================================

OSO:DeploymentDateShape
    a sh:NodeShape ;
    sh:targetSubjectsOf OSO:dateFirstDeployment ;
    sh:targetSubjectsOf OSO:dateEndDeployment ;

    sh:property [
        sh:path OSO:dateFirstDeployment ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:gYearMonth ]
            [ sh:datatype xsd:gYear ]
        ) ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path OSO:dateEndDeployment ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:gYearMonth ]
            [ sh:datatype xsd:gYear ]
        ) ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# SubPlatformShape
# Validates OSO observation subplatforms.
#
# Checks:
# - isSubPlatformOf values are IRIs
# - isSubPlatformOf values are instances of OSO:Platform
#
# Note:
# - the presence of isSubPlatformOf is not mandatory in this SHACL profile
# - no maximum number of parent platforms is imposed at this stage
# =============================================================================

OSO:SubPlatformShape
    a sh:NodeShape ;
    sh:targetClass OSO:SubPlatform ;

    sh:property [
        sh:path OSO:isSubPlatformOf ;
        sh:class OSO:Platform ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# SubsiteShape
# Validates OSO observation subsites.
#
# Checks:
# - isSubsiteOf values are IRIs
# - isSubsiteOf values are instances of OSO:Site
#
# Note:
# - the presence of isSubsiteOf is not mandatory in this SHACL profile
# - no maximum number of parent sites is imposed at this stage
# =============================================================================

OSO:SubsiteShape
    a sh:NodeShape ;
    sh:targetClass OSO:Subsite ;

    sh:property [
        sh:path OSO:isSubsiteOf ;
        sh:class OSO:Site ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# TestSiteShape
# Validates the test-site flag used by OSO sites and subsites.
#
# Checks:
# - isTestSite values use the xsd:boolean datatype
# - at most one isTestSite value is provided
#
# Note:
# - the presence of isTestSite is optional
# =============================================================================

OSO:TestSiteShape
    a sh:NodeShape ;
    sh:targetSubjectsOf OSO:isTestSite ;

    sh:property [
        sh:path OSO:isTestSite ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# WaterDepthShape
# Validates water-depth information in OSO.
#
# Checks:
# - minWaterDepth values use the xsd:integer datatype
# - maxWaterDepth values use the xsd:integer datatype
# - each depth value occurs at most once
# - minWaterDepth is less than or equal to maxWaterDepth when both are provided
#
# Note:
# - water-depth information is optional
# - depths are expressed as integer values in metres
# =============================================================================

OSO:WaterDepthShape
    a sh:NodeShape ;
    sh:targetSubjectsOf OSO:minWaterDepth ;
    sh:targetSubjectsOf OSO:maxWaterDepth ;

    sh:property [
        sh:path OSO:minWaterDepth ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path OSO:maxWaterDepth ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path OSO:minWaterDepth ;
        sh:lessThanOrEquals OSO:maxWaterDepth ;
        sh:severity sh:Violation ;
        sh:message "Minimum water depth must be less than or equal to maximum water depth."@en ;
    ] .

# =============================================================================
# DistanceFromLandShape
# Validates the distance from land information in OSO.
#
# Checks:
# - distanceFromLand values use the xsd:decimal datatype
# - distanceFromLand is greater than or equal to zero
# - at most one distanceFromLand value is provided
#
# Note:
# - distanceFromLand information is optional
# - distances are expressed in nautical miles
# =============================================================================

OSO:DistanceFromLandShape
    a sh:NodeShape ;
    sh:targetSubjectsOf OSO:distanceFromLand ;

    sh:property [
        sh:path OSO:distanceFromLand ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# PersistentIdentifierShape
# Validates persistent identifiers used for persons and organizations in OSO.
#
# Checks:
# - hasORCID values are IRIs
# - hasROR values are IRIs
# - at most one ORCID identifier is provided per resource
# - at most one ROR identifier is provided per resource
#
# Note:
# - ORCID and ROR identifiers are optional
# - URI patterns are not checked at this stage
# =============================================================================

OSO:PersistentIdentifierShape
    a sh:NodeShape ;
    sh:targetSubjectsOf OSO:hasORCID ;
    sh:targetSubjectsOf OSO:hasROR ;

    sh:property [
        sh:path OSO:hasORCID ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path OSO:hasROR ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# CountryShape
# Validates country references used in OSO.
#
# Checks:
# - hasCountry values are IRIs
#
# Note:
# - country information is optional
# - external country resources are not required to be locally typed
# =============================================================================

OSO:CountryShape
    a sh:NodeShape ;
    sh:targetSubjectsOf OSO:hasCountry ;

    sh:property [
        sh:path OSO:hasCountry ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# PrincipalInvestigatorShape
# Validates principal investigator relationships in OSO.
#
# Checks:
# - hasPrincipalInvestigator values are IRIs
# - hasPrincipalInvestigator values are instances of schema:Person
#
# Note:
# - the presence of a principal investigator is optional
# - no maximum number of principal investigators is imposed
# =============================================================================

OSO:PrincipalInvestigatorShape
    a sh:NodeShape ;
    sh:targetSubjectsOf OSO:hasPrincipalInvestigator ;

    sh:property [
        sh:path OSO:hasPrincipalInvestigator ;
        sh:class schema1:Person ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# LedByOrganizationShape
# Validates organization leadership relationships in OSO.
#
# Checks:
# - isLedByOrganization values are IRIs
# - isLedByOrganization values are instances of foaf:Organization
#
# Note:
# - the presence of isLedByOrganization is optional
# - the property may be used by OSO:RegionalFacility and OSO:OceanographicCampaign
# - no maximum number of leading organizations is imposed
# =============================================================================

OSO:LedByOrganizationShape
    a sh:NodeShape ;
    sh:targetSubjectsOf OSO:isLedByOrganization ;

    sh:property [
        sh:path OSO:isLedByOrganization ;
        sh:class foaf:Organization ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# SiteResponsibleShape
# Validates site-responsibility relationships in OSO.
#
# Checks:
# - hasSiteResponsible values are IRIs
# - hasSiteResponsible values are instances of schema:Person
#
# Note:
# - the presence of hasSiteResponsible is optional
# - more than one responsible person may be associated with a site
# =============================================================================

OSO:SiteResponsibleShape
    a sh:NodeShape ;
    sh:targetSubjectsOf OSO:hasSiteResponsible ;

    sh:property [
        sh:path OSO:hasSiteResponsible ;
        sh:class schema1:Person ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# EDMOIdentifierShape
# Validates EDMO references associated with organizations in OSO.
#
# Checks:
# - hasEDMO values are IRIs
# - at most one hasEDMO value is provided per organization
#
# Note:
# - the presence of hasEDMO is optional
# - no specific RDF class is required for the referenced EDMO resource
# =============================================================================

OSO:EDMOIdentifierShape
    a sh:NodeShape ;
    sh:targetSubjectsOf OSO:hasEDMO ;

    sh:property [
        sh:path OSO:hasEDMO ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# RegionalTeamLeaderShape
# Validates regional team leader relationships in OSO.
#
# Checks:
# - hasRegionalTeamLeader values are IRIs
# - hasRegionalTeamLeader values are instances of schema:Person
# - at most one regional team leader is provided per Regional Facility
#
# Note:
# - the presence of hasRegionalTeamLeader is optional
# =============================================================================

OSO:RegionalTeamLeaderShape
    a sh:NodeShape ;
    sh:targetSubjectsOf OSO:hasRegionalTeamLeader ;

    sh:property [
        sh:path OSO:hasRegionalTeamLeader ;
        sh:class schema1:Person ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# HasERICMembershipShape
# Validates ERIC membership links from Regional Facilities.
#
# Checks:
# - hasERICMembership values are IRIs
# - hasERICMembership values are instances of OSO:ERICMembership
#
# Note:
# - the presence of hasERICMembership is optional
# - more than one ERIC membership may be associated with a Regional Facility
# =============================================================================

OSO:HasERICMembershipShape
    a sh:NodeShape ;
    sh:targetSubjectsOf OSO:hasERICMembership ;

    sh:property [
        sh:path OSO:hasERICMembership ;
        sh:class OSO:ERICMembership ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# OrganizationMembershipShape
# Validates ERIC membership relationships for organizations in OSO.
#
# Checks:
# - isMemberOf values are IRIs
# - isMemberOf values are instances of OSO:ERIC
#
# Note:
# - the presence of isMemberOf is optional
# - an organization may be associated with more than one ERIC
# =============================================================================

OSO:OrganizationMembershipShape
    a sh:NodeShape ;
    sh:targetSubjectsOf OSO:isMemberOf ;

    sh:property [
        sh:path OSO:isMemberOf ;
        sh:class OSO:ERIC ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
    ] .

# =============================================================================
# SiteSubsiteShape
# Validates relationships between sites and their subsites in OSO.
#
# Checks:
# - hasSubsite values are IRIs
# - hasSubsite values are instances of OSO:Subsite
#
# Note:
# - the presence of hasSubsite is optional
# - a site may be associated with more than one subsite
# =============================================================================

OSO:SiteSubsiteShape
    a sh:NodeShape ;
    sh:targetSubjectsOf OSO:Site_has_a_Subsite ;

    sh:property [
        sh:path OSO:hasSubsite ;
        sh:class OSO:Subsite ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
    ] .
