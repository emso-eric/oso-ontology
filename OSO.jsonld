      {
        "@language": "it",
        "@value": "EMSO Italia"
      },
      {
        "@language": "en",
        "@value": "Italian component of EMSO ERIC"
      },
      {
        "@language": "it",
        "@value": "Componente italiana di EMSO ERIC"
      },
      {
        "@language": "en",
        "@value": "EMSO Italia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "fr",
        "@value": "La composante italienne d’EMSO ERIC, dédiée à l’observation multidisciplinaire à long terme du fond marin et de la colonne d’eau dans la région méditerranéenne."
      },
      {
        "@language": "pt",
        "@value": "A componente italiana do EMSO ERIC, dedicada à observação multidisciplinar de longo prazo do fundo marinho e da coluna de água na região mediterrânica."
      },
      {
        "@language": "ro",
        "@value": "Componenta italiană a EMSO ERIC, dedicată observației multidisciplinare pe termen lung a fundului marin și a coloanei de apă din regiunea mediteraneană."
      },
      {
        "@language": "en",
        "@value": "The Italian component of EMSO ERIC, supporting long-term multidisciplinary observation of the seafloor and water column in the Mediterranean region."
      },
      {
        "@language": "es",
        "@value": "La componente italiana de EMSO ERIC, dedicada a la observación multidisciplinaria a largo plazo del fondo marino y de la columna de agua en la región mediterránea."
      },
      {
        "@language": "no",
        "@value": "Den italienske delen av EMSO ERIC, dedikert til langsiktig tverrfaglig observasjon av havbunnen og vannsøylen i Middelhavsregionen."
      },
      {
        "@language": "it",
        "@value": "La componente italiana di EMSO ERIC, dedicata all’osservazione multidisciplinare a lungo termine del fondale marino e della colonna d’acqua nella regione mediterranea."
      },
      {
        "@language": "el",
        "@value": "Η ιταλική συνιστώσα του EMSO ERIC, αφιερωμένη στη μακροχρόνια πολυεπιστημονική παρατήρηση του θαλάσσιου πυθμένα και της υδάτινης στήλης στην περιοχή της Μεσογείου."
      }
