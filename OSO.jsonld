      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A French research laboratory specializing in computer science, robotics, microelectronics and semantic technologies. LIRMM develops AgroPortal and O'FAIRe."
      },
      {
        "@language": "fr",
        "@value": "Un laboratoire de recherche français spécialisé en informatique, robotique, microélectronique et technologies sémantiques. Le LIRMM développe notamment AgroPortal et O'FAIRe."
      },
      {
        "@language": "it",
        "@value": "Un laboratorio di ricerca francese specializzato in informatica, robotica, microelettronica e tecnologie semantiche. LIRMM sviluppa AgroPortal e O'FAIRe."
      },
      {
        "@language": "no",
        "@value": "Et fransk forskningslaboratorium spesialisert innen informatikk, robotikk, mikroelektronikk og semantiske teknologier. LIRMM utvikler AgroPortal og O'FAIRe."
      },
      {
        "@language": "es",
        "@value": "Un laboratorio de investigación francés especializado en informática, robótica, microelectrónica y tecnologías semánticas. LIRMM desarrolla AgroPortal y O'FAIRe."
      },
      {
        "@language": "pt",
        "@value": "Um laboratório de investigação francês especializado em informática, robótica, microeletrónica e tecnologias semânticas. O LIRMM desenvolve o AgroPortal e o O'FAIRe."
      },
      {
        "@language": "el",
        "@value": "Ένα γαλλικό ερευνητικό εργαστήριο που ειδικεύεται στην πληροφορική, τη ρομποτική, τη μικροηλεκτρονική και τις σημασιολογικές τεχνολογίες. Το LIRMM αναπτύσσει το AgroPortal και το O'FAIRe."
      },
