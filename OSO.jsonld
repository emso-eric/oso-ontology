    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "fr",
        "@value": "Lie une infrastructure régionale à un projet de recherche associé."
      },
      {
        "@language": "en",
        "@value": "Links a regional facility to a related research project."
      },
      {
        "@language": "el",
        "@value": "Συνδέει μια περιφερειακή υποδομή με ένα σχετικό ερευνητικό έργο."
      },
      {
        "@language": "pt",
        "@value": "Liga uma infraestrutura regional a um projeto de investigação associado."
      },
      {
        "@language": "es",
        "@value": "Relaciona una infraestructura regional con un proyecto de investigación asociado."
      },
      {
        "@language": "it",
        "@value": "Collega un'infrastruttura regionale a un progetto di ricerca associato."
      },
      {
        "@language": "no",
        "@value": "Knytter en regional infrastruktur til et tilknyttet forskningsprosjekt."
      },
      {
        "@language": "ro",
        "@value": "Leagă o infrastructură regională de un proiect de cercetare asociat."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
