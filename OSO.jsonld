    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "it",
        "@value": "Un centro di ricerca della Stanford University dedicato all'informatica biomedica e allo sviluppo di tecnologie semantiche, incluso l'editor di ontologie Protégé."
      },
      {
        "@language": "es",
        "@value": "Un centro de investigación de la Universidad de Stanford dedicado a la informática biomédica y al desarrollo de tecnologías semánticas, incluido el editor de ontologías Protégé."
      },
      {
        "@language": "en",
        "@value": "A research center at Stanford University dedicated to biomedical informatics and the development of semantic technologies, including the Protégé ontology editor."
      },
      {
        "@language": "no",
        "@value": "Et forskningssenter ved Stanford University dedikert til biomedisinsk informatikk og utvikling av semantiske teknologier, inkludert ontologiredigereren Protégé."
      },
      {
        "@language": "pt",
        "@value": "Um centro de investigação da Universidade de Stanford dedicado à informática biomédica e ao desenvolvimento de tecnologias semânticas, incluindo o editor de ontologias Protégé."
      },
      {
        "@language": "ro",
        "@value": "Un centru de cercetare al Universității Stanford dedicat informaticii biomedicale și dezvoltării tehnologiilor semantice, inclusiv editorului de ontologii Protégé."
      },
      {
        "@language": "fr",
        "@value": "Un centre de recherche de l'Université Stanford consacré à l'informatique biomédicale et au développement de technologies sémantiques, notamment de l'éditeur d'ontologies Protégé."
      },
      {
        "@language": "el",
        "@value": "Ένα ερευνητικό κέντρο του Πανεπιστημίου Stanford αφιερωμένο στη βιοϊατρική πληροφορική και στην ανάπτυξη σημασιολογικών τεχνολογιών, συμπεριλαμβανομένου του επεξεργαστή οντολογιών Protégé."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
