    "https://w3id.org/mod#competencyQuestion": [
      {
        "@language": "it",
        "@value": "Quali piattaforme appartengono a un sito specifico?"
      },
      {
        "@language": "en",
        "@value": "Which sites are part of a regional facility?"
      },
      {
        "@language": "el",
        "@value": "Ποιες ωκεανογραφικές αποστολές συνδέονται με μια περιφερειακή υποδομή;"
      },
      {
        "@language": "no",
        "@value": "Hvilke steder er en del av en regional infrastruktur?"
