      },
      {
        "@language": "pt",
        "@value": "MARMOR"
      },
      {
        "@language": "it",
        "@value": "MARMOR"
      },
      {
        "@language": "fr",
        "@value": "MARMOR"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Marine Advanced Geophysical Research Equipment and Mayotte Multidisciplinary Observatory for Research and Response"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "fr",
        "@value": "Projet ANR d’une durée de huit ans visant à développer des équipements géophysiques marins avancés et un observatoire sous-marin multidisciplinaire pour le suivi à long terme de la crise sismo-volcanique de Mayotte."
      },
      {
        "@language": "en",
        "@value": "Eight-year ANR-funded project developing advanced marine geophysical instrumentation and a multidisciplinary underwater observatory for long-term monitoring of the Mayotte seismo-volcanic crisis."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
