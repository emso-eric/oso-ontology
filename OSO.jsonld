    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Coastal cabled marine observation site located in the Iroise Sea and operated as an EMSO-France test site between 2012 and 2017."
      },
      {
        "@language": "br",
        "@value": "Lec’h sellout ouzh ar mor kevreet dre gebl e Mor Iroise, implijet evel lec’h arnodiñ ha heuliañ ar vevliesseurted hag ar biomassezhioù gant EMSO-France etre 2012 ha 2017."
      },
      {
        "@language": "fr",
        "@value": "Site côtier câblé d’observation marine situé en mer d’Iroise et exploité comme site test d’EMSO-France entre 2012 et 2017."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
