    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Relación de adhesión que indica que la Regional Facility Balearic Sea forma parte de EMSO desde el 29 de septiembre de 2016."
      },
      {
        "@language": "fr",
        "@value": "Relation d’adhésion indiquant que la Regional Facility Balearic Sea fait partie d’EMSO depuis le 29 septembre 2016."
      },
      {
        "@language": "no",
        "@value": "Relasjon som angir at Regional Facility Balearic Sea er del av EMSO siden 29. september 2016."
      },
      {
        "@language": "ro",
        "@value": "Relație de aderare care indică faptul că Regional Facility Balearic Sea face parte din EMSO din 29 septembrie 2016."
      },
      {
        "@language": "el",
        "@value": "Σχέση συμμετοχής που δηλώνει ότι η Περιφερειακή Εγκατάσταση Balearic Sea αποτελεί μέρος του EMSO από τις 29 Σεπτεμβρίου 2016."
      },
      {
        "@language": "pt",
        "@value": "Relação de adesão indicando que a Regional Facility Balearic Sea faz parte do EMSO desde 29 de setembro de 2016."
