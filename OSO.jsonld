  {
    "@id": "https://w3id.org/earthsemantics/OSO#RegionalFacility_is_related_to_RI",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ro",
        "@value": "O infrastructură regională poate fi legată de una sau mai multe infrastructuri de cercetare fără o relație formală de apartenență."
      },
      {
        "@language": "no",
        "@value": "En regional infrastruktur kan være knyttet til en eller flere forskningsinfrastrukturer uten et formelt del-forhold."
      },
      {
        "@language": "el",
        "@value": "Μια περιφερειακή υποδομή μπορεί να σχετίζεται με μία ή περισσότερες ερευνητικές υποδομές χωρίς επίσημη σχέση μέρους-όλου."
      },
      {
        "@language": "it",
        "@value": "Un'infrastruttura regionale può essere collegata a una o più infrastrutture di ricerca senza una relazione formale di appartenenza."
      },
      {
        "@language": "pt",
        "@value": "Uma infraestrutura regional pode estar relacionada com uma ou mais infraestruturas de investigação sem uma relação formal de pertença."
      },
      {
        "@language": "en",
        "@value": "A regional facility may be related to one or more research infrastructures without a formal part-whole relationship."
      },
      {
        "@language": "es",
        "@value": "Una infraestructura regional puede estar relacionada con una o varias infraestructuras de investigación sin una relación formal de pertenencia."
      },
      {
        "@language": "fr",
        "@value": "Une infrastructure régionale peut être liée à une ou plusieurs infrastructures de recherche sans relation formelle de composition."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/earthsemantics/OSO#RegionalFacility"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ro",
        "@value": "Infrastructura regională este legată de o infrastructură de cercetare"
      },
      {
        "@language": "en",
        "@value": "Regional Facility is related to a Research Infrastructure"
      },
      {
        "@language": "fr",
        "@value": "L’infrastructure régionale est liée à une infrastructure de recherche"
      },
      {
        "@language": "el",
        "@value": "Η περιφερειακή υποδομή σχετίζεται με ερευνητική υποδομή"
      },
      {
        "@language": "no",
        "@value": "Regional infrastruktur er relatert til en forskningsinfrastruktur"
      },
      {
        "@language": "pt",
        "@value": "A infraestrutura regional está relacionada com uma infraestrutura de investigação"
      },
      {
        "@language": "es",
        "@value": "La infraestructura regional está relacionada con una infraestructura de investigación"
      },
      {
        "@language": "it",
        "@value": "L'infrastruttura regionale è collegata a un'infrastruttura di ricerca"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/earthsemantics/OSO#ResearchInfrastructure"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates a regional facility to a research infrastructure with which it has an association, without necessarily being formally part of it."
      },
      {
        "@language": "es",
        "@value": "Relaciona una infraestructura regional con una infraestructura de investigación con la que mantiene una asociación, sin formar necesariamente parte formal de ella."
      },
      {
        "@language": "pt",
        "@value": "Liga uma infraestrutura regional a uma infraestrutura de investigação com a qual possui uma associação, sem necessariamente fazer formalmente parte dela."
      },
      {
        "@language": "ro",
        "@value": "Leagă o infrastructură regională de o infrastructură de cercetare cu care are o asociere, fără a face neapărat parte oficial din aceasta."
      },
      {
        "@language": "el",
        "@value": "Συνδέει μια περιφερειακή υποδομή με μια ερευνητική υποδομή με την οποία έχει σχέση, χωρίς απαραίτητα να αποτελεί επίσημα μέρος της."
      },
      {
        "@language": "it",
        "@value": "Collega un'infrastruttura regionale a un'infrastruttura di ricerca con cui ha un'associazione, senza necessariamente farne formalmente parte."
      },
      {
        "@language": "fr",
        "@value": "Relie une infrastructure régionale à une infrastructure de recherche avec laquelle elle possède une association, sans nécessairement en faire formellement partie."
      },
      {
        "@language": "no",
        "@value": "Knytter en regional infrastruktur til en forskningsinfrastruktur som den har en tilknytning til, uten nødvendigvis å være formelt en del av den."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "no",
        "@value": "Regional infrastruktur er relatert til en forskningsinfrastruktur"
      },
      {
        "@language": "pt",
        "@value": "A infraestrutura regional está relacionada com uma infraestrutura de investigação"
      },
      {
        "@language": "es",
        "@value": "La infraestructura regional está relacionada con una infraestructura de investigación"
      },
      {
        "@language": "it",
        "@value": "L'infrastruttura regionale è collegata a un'infrastruttura di ricerca"
      },
      {
        "@language": "ro",
        "@value": "Infrastructura regională este legată de o infrastructură de cercetare"
      },
      {
        "@language": "en",
        "@value": "Regional Facility is related to a Research Infrastructure"
      },
      {
        "@language": "fr",
        "@value": "L’infrastructure régionale est liée à une infrastructure de recherche"
      },
      {
        "@language": "el",
        "@value": "Η περιφερειακή υποδομή σχετίζεται με ερευνητική υποδομή"
      }
    ]
