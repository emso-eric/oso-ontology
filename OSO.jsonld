    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "el",
        "@value": "Μια πλατφόρμα λογισμικού που υποστηρίζει τη συνεργατική ανάπτυξη λογισμικού, τον έλεγχο εκδόσεων, την παρακολούθηση ζητημάτων και τη διαχείριση πηγαίου κώδικα."
      },
      {
        "@language": "no",
        "@value": "En programvareplattform som støtter samarbeidsbasert programvareutvikling, versjonskontroll, saksoppfølging og håndtering av kildekode."
      },
      {
        "@language": "it",
        "@value": "Una piattaforma software che supporta lo sviluppo collaborativo, il controllo di versione, il tracciamento delle issue e la gestione del codice sorgente."
      },
      {
        "@language": "fr",
        "@value": "Une plateforme logicielle prenant en charge le développement collaboratif, le contrôle de version, le suivi des tickets et la gestion du code source."
      },
      {
        "@language": "ro",
        "@value": "O platformă software care sprijină dezvoltarea colaborativă, controlul versiunilor, urmărirea problemelor și gestionarea codului sursă."
      },
      {
        "@language": "pt",
        "@value": "Uma plataforma de software que suporta o desenvolvimento colaborativo, o controlo de versões, o acompanhamento de problemas e a gestão do código-fonte."
      },
      {
        "@language": "en",
        "@value": "A software platform supporting collaborative software development, version control, issue tracking and source code management."
      },
      {
        "@language": "es",
        "@value": "Una plataforma de software que permite el desarrollo colaborativo, el control de versiones, el seguimiento de incidencias y la gestión del código fuente."
      }
    ]
  },
