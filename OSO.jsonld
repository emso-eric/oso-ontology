  {
    "@id": "https://w3id.org/earthsemantics/OSO#hasDataAndScienceOfficer",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "pt",
        "@value": "Liga um ERIC à pessoa que exerce a função de Data and Science Officer."
      },
      {
        "@language": "ro",
        "@value": "Leagă un ERIC de persoana care exercită funcția de Data and Science Officer."
      },
      {
        "@language": "no",
        "@value": "Knytter et ERIC til personen som fungerer som Data and Science Officer."
      },
      {
        "@language": "es",
        "@value": "Relaciona un ERIC con la persona que ejerce el cargo de Data and Science Officer."
      },
      {
        "@language": "en",
        "@value": "Links an ERIC to the person acting as Data and Science Officer."
      },
      {
        "@language": "el",
        "@value": "Συνδέει ένα ERIC με το πρόσωπο που ασκεί τον ρόλο του Υπεύθυνου Δεδομένων και Επιστήμης."
      },
      {
        "@language": "it",
        "@value": "Collega un ERIC alla persona che svolge il ruolo di Data and Science Officer."
      },
      {
        "@language": "fr",
        "@value": "Lie un ERIC à la personne exerçant la fonction de Data and Science Officer."
      }
    ],
