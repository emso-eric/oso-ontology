    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A fixed subsurface vertical profiler platform deployed offshore Cape Saint Vincent, Portugal, for long-term oceanographic monitoring in the Northeast Atlantic Ocean."
      },
      {
        "@language": "pt",
        "@value": "Uma plataforma fixa de perfilagem vertical subsuperficial implantada ao largo do Cabo de São Vicente, em Portugal, para monitorização oceanográfica de longo prazo no Oceano Atlântico Nordeste."
      },
      {
        "@language": "fr",
        "@value": "Une plateforme fixe de profilage vertical sous-surface déployée au large du cap Saint-Vincent, au Portugal, pour la surveillance océanographique à long terme dans l’océan Atlantique Nord-Est."
      }
    ],
