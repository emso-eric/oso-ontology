      },
      {
        "@language": "el",
        "@value": "E1M3A"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://poseidon.hcmr.gr/"
      },
      {
        "@id": "https://www.jerico-ri.eu/2021/05/19/jerico-s3-ta-facility-of-the-week-e1-m3a-station-poseidon/"
      },
      {
