    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ro",
        "@value": "Un site observator localizat, asociat cu o facilitate regională, care poate găzdui una sau mai multe platforme de măsurare."
      },
      {
        "@language": "it",
        "@value": "Un sito osservatorio localizzato, collegato a una struttura regionale, che può ospitare una o più piattaforme di misura."
      },
      {
        "@language": "es",
        "@value": "Un sitio de observación localizado, vinculado a una infraestructura regional, que puede albergar una o más plataformas de medición."
      },
      {
        "@language": "pt",
        "@value": "Um local de observação localizado, associado a uma infraestrutura regional, podendo acolher uma ou mais plataformas de medição."
      },
      {
        "@language": "no",
        "@value": "Et lokalisert observasjonssted tilknyttet en regional fasilitet, som potensielt huser en eller flere måleplattformer."
      },
      {
        "@language": "fr",
        "@value": "Un site observatoire localisé, rattaché à un nœud régional, pouvant accueillir une ou plusieurs plateformes de mesure."
      },
      {
        "@language": "el",
        "@value": "Ένας τοπικός τόπος παρατήρησης, συνδεδεμένος με μια περιφερειακή υποδομή, που μπορεί να φιλοξενήσει μία ή περισσότερες πλατφόρμες μέτρησης."
      },
      {
        "@language": "en",
        "@value": "A localized observatory site, attached to a regional facility, potentially hosting one or more measurement platforms."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
