  {
    "@id": "https://w3id.org/earthsemantics/OSO#CHEREEF_OBS",
    "@type": [
      "https://w3id.org/earthsemantics/OSO#SeriesOfOceanographicCampaigns",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "10.18142/248"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "fr",
        "@value": "CHEREEF-OBS est une série de campagnes d’observation océanographique dédiées au suivi à long terme des écosystèmes de coraux d’eau froide dans le canyon de Lampaul."
      },
      {
        "@language": "ro",
        "@value": "CHEREEF-OBS este o serie de campanii de observație oceanografică dedicate monitorizării pe termen lung a ecosistemelor de corali de apă rece din canionul Lampaul."
      },
      {
        "@language": "es",
        "@value": "CHEREEF-OBS es una serie de campañas de observación oceanográfica dedicadas al seguimiento a largo plazo de los ecosistemas de corales de aguas frías en el cañón de Lampaul."
      },
      {
        "@language": "it",
        "@value": "CHEREEF-OBS è una serie di campagne di osservazione oceanografica dedicate al monitoraggio a lungo termine degli ecosistemi di coralli di acque fredde nel canyon di Lampaul."
      },
      {
        "@language": "pt",
        "@value": "CHEREEF-OBS é uma série de campanhas de observação oceanográfica dedicadas ao acompanhamento de longo prazo dos ecossistemas de corais de águas frias no canyon de Lampaul."
      },
      {
        "@language": "no",
        "@value": "CHEREEF-OBS er en serie oseanografiske observasjonskampanjer dedikert til langsiktig overvåking av økosystemer med kaldtvannskoraller i Lampaul-kløften."
      },
      {
        "@language": "el",
        "@value": "CHEREEF-OBS είναι μια σειρά ωκεανογραφικών αποστολών παρατήρησης αφιερωμένων στη μακροχρόνια παρακολούθηση οικοσυστημάτων κοραλλιών ψυχρών υδάτων στο φαράγγι Lampaul."
      },
      {
        "@language": "en",
        "@value": "CHEREEF-OBS is a series of oceanographic observation campaigns dedicated to the long-term monitoring of cold-water coral ecosystems in the Lampaul Canyon."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
