    "http://purl.org/dc/terms/description": [
      {
        "@language": "pt",
        "@value": "O EMSO Portugal é a contribuição portuguesa para a infraestrutura europeia de investigação EMSO, coordenando atividades de observação oceânica multidisciplinar de longo prazo e desenvolvimentos tecnológicos, particularmente nas regiões dos Açores e do Atlântico."
      },
      {
        "@language": "en",
        "@value": "EMSO Portugal is the Portuguese contribution to the EMSO European research infrastructure, coordinating long-term multidisciplinary ocean observation activities and technological developments, particularly in the Azores and Atlantic regions."
      },
      {
        "@language": "fr",
        "@value": "EMSO Portugal est la contribution portugaise à l’infrastructure de recherche européenne EMSO, coordonnant des activités d’observation océanique multidisciplinaire à long terme et des développements technologiques, notamment dans les régions des Açores et de l’Atlantique."
      }
    ],
