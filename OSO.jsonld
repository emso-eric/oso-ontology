  {
    "@id": "https://w3id.org/earthsemantics/OSO#EMSO-Italia",
    "@type": [
      "https://w3id.org/earthsemantics/OSO#ResearchInfrastructure",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "fr",
        "@value": "EMSO-Italia est la contribution italienne à l’infrastructure de recherche européenne EMSO, coordonnant des observatoires marins multidisciplinaires et des activités d’observation océanique à long terme en mer Méditerranée."
      },
      {
        "@language": "it",
        "@value": "EMSO-Italia è il contributo italiano all'infrastruttura di ricerca europea EMSO, coordinando osservatori marini multidisciplinari e attività di osservazione oceanica a lungo termine nel Mar Mediterraneo."
      },
      {
        "@language": "ro",
        "@value": "EMSO-Italia reprezintă contribuția italiană la infrastructura europeană de cercetare EMSO, coordonând observatoare marine multidisciplinare și activități de observare oceanografică pe termen lung în Marea Mediterană."
      },
      {
        "@language": "en",
        "@value": "EMSO-Italia is the Italian contribution to the EMSO European research infrastructure, coordinating multidisciplinary marine observatories and long-term ocean observation activities in the Mediterranean Sea."
      },
      {
        "@language": "pt",
        "@value": "EMSO-Italia é a contribuição italiana para a infraestrutura europeia de investigação EMSO, coordenando observatórios marinhos multidisciplinares e atividades de observação oceânica de longo prazo no Mar Mediterrâneo."
      },
      {
        "@language": "es",
        "@value": "EMSO-Italia es la contribución italiana a la infraestructura europea de investigación EMSO, coordinando observatorios marinos multidisciplinares y actividades de observación oceánica a largo plazo en el mar Mediterráneo."
      },
      {
        "@language": "el",
        "@value": "Το EMSO-Italia αποτελεί την ιταλική συμβολή στην ευρωπαϊκή ερευνητική υποδομή EMSO, συντονίζοντας πολυεπιστημονικά θαλάσσια παρατηρητήρια και δραστηριότητες μακροχρόνιας ωκεανογραφικής παρατήρησης στη Μεσόγειο Θάλασσα."
      },
      {
        "@language": "no",
        "@value": "EMSO-Italia er det italienske bidraget til den europeiske forskningsinfrastrukturen EMSO, og koordinerer tverrfaglige marine observatorier og langsiktige havobservasjonsaktiviteter i Middelhavet."
      }
    ],
    "http://schema.org/logo": [
      {
        "@id": "https://raw.githubusercontent.com/emso-eric/oso-ontology/main/images/emso_italia.png"
      }
    ],
