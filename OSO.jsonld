    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "it",
        "@value": "Data and Science Officer di EMSO ERIC, responsabile della gestione dei dati, dell'interoperabilità, del coordinamento scientifico e delle pratiche FAIR nell'infrastruttura di ricerca EMSO."
      },
      {
        "@language": "fr",
        "@value": "Data and Science Officer d’EMSO ERIC, chargé de la gestion des données, de l’interopérabilité, de la coordination scientifique et des pratiques FAIR au sein de l’infrastructure de recherche EMSO."
      },
      {
        "@language": "no",
        "@value": "Data and Science Officer i EMSO ERIC, med ansvar for dataforvaltning, interoperabilitet, vitenskapelig koordinering og FAIR-praksis på tvers av EMSOs forskningsinfrastruktur."
      },
      {
        "@language": "en",
        "@value": "Data and Science Officer at EMSO ERIC, supporting data management, interoperability, scientific coordination and FAIR data practices across the EMSO research infrastructure."
      },
      {
        "@language": "el",
        "@value": "Υπεύθυνος Δεδομένων και Επιστήμης (Data and Science Officer) του EMSO ERIC, αρμόδιος για τη διαχείριση δεδομένων, τη διαλειτουργικότητα, τον επιστημονικό συντονισμό και τις πρακτικές FAIR στην ερευνητική υποδομή του EMSO."
      },
      {
        "@language": "ro",
        "@value": "Data and Science Officer al EMSO ERIC, responsabil pentru gestionarea datelor, interoperabilitate, coordonare științifică și practicile FAIR în infrastructura de cercetare EMSO."
      },
      {
        "@language": "pt",
        "@value": "Data and Science Officer da EMSO ERIC, responsável pela gestão de dados, interoperabilidade, coordenação científica e práticas FAIR em toda a infraestrutura de investigação EMSO."
      },
      {
        "@language": "es",
        "@value": "Data and Science Officer de EMSO ERIC, encargado de la gestión de datos, la interoperabilidad, la coordinación científica y las prácticas FAIR en toda la infraestructura de investigación EMSO."
      }
