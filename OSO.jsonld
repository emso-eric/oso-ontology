    "http://purl.org/dc/terms/description": [
      {
        "@language": "pt",
        "@value": "A FCT é a organização portuguesa associada à participação no EMSO e à coordenação nacional de atividades de investigação e inovação relevantes para infraestruturas de observação marinha."
      },
      {
        "@language": "en",
        "@value": "FCT is the Portuguese organisation associated with EMSO membership and national coordination for research and innovation activities relevant to marine observation infrastructures."
      },
      {
        "@language": "fr",
        "@value": "La FCT est l’organisation portugaise associée à l’adhésion à EMSO et à la coordination nationale d’activités de recherche et d’innovation liées aux infrastructures d’observation marine."
      }
    ],
