    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "it",
        "@value": "Data che segna la fine del dispiegamento operativo di uno strumento, piattaforma, sito o infrastruttura."
      },
      {
        "@language": "pt",
        "@value": "Data que marca o fim da implantação operacional de um instrumento, plataforma, local ou infraestrutura."
      },
      {
        "@language": "en",
        "@value": "Date marking the end of operational deployment of an instrument, platform, site, or infrastructure."
      },
      {
        "@language": "ro",
        "@value": "Data care marchează sfârșitul desfășurării operaționale a unui instrument, platforme, sit sau infrastructuri."
      },
      {
        "@language": "el",
        "@value": "Ημερομηνία που σηματοδοτεί το τέλος της επιχειρησιακής εγκατάστασης ενός οργάνου, πλατφόρμας, τοποθεσίας ή υποδομής."
      },
      {
