      },
      {
        "@language": "en",
        "@value": "EMBRC France"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "fr",
        "@value": "Le nœud français du Centre européen de ressources biologiques marines (EMBRC), fournissant un accès aux ressources biologiques marines, aux écosystèmes et aux services associés pour la recherche et l’innovation."
      },
      {
        "@language": "pt",
        "@value": "O nó francês do Centro Europeu de Recursos Biológicos Marinhos (EMBRC), fornecendo acesso a recursos biológicos marinhos, ecossistemas e serviços associados para investigação e inovação."
      },
      {
        "@language": "en",
        "@value": "The French node of the European Marine Biological Resource Centre (EMBRC), providing access to marine biological resources, ecosystems and associated services for research and innovation."
      },
      {
        "@language": "no",
        "@value": "Den franske noden til European Marine Biological Resource Centre (EMBRC), som gir tilgang til marine biologiske ressurser, økosystemer og tilknyttede tjenester for forskning og innovasjon."
      },
      {
        "@language": "it",
        "@value": "Il nodo francese del Centro Europeo per le Risorse Biologiche Marine (EMBRC), che fornisce accesso a risorse biologiche marine, ecosistemi e servizi associati per la ricerca e l’innovazione."
      },
      {
        "@language": "ro",
        "@value": "Nodul francez al Centrului European pentru Resurse Biologice Marine (EMBRC), care oferă acces la resurse biologice marine, ecosisteme și servicii asociate pentru cercetare și inovare."
      },
      {
        "@language": "es",
        "@value": "El nodo francés del Centro Europeo de Recursos Biológicos Marinos (EMBRC), que proporciona acceso a recursos biológicos marinos, ecosistemas y servicios asociados para la investigación y la innovación."
      },
      {
        "@language": "el",
        "@value": "Ο γαλλικός κόμβος του Ευρωπαϊκού Κέντρου Θαλάσσιων Βιολογικών Πόρων (EMBRC), που παρέχει πρόσβαση σε θαλάσσιους βιολογικούς πόρους, οικοσυστήματα και συναφείς υπηρεσίες για έρευνα και καινοτομία."
      }
    ],
